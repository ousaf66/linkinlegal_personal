# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug
CLIENT_URL=http://localhost:3000
CLIENT_URLS=http://localhost:3000
WEB_URL=http://localhost:3100
BACKEND_URL=http://localhost:4000

# ── Database ────────────────────────────────────────────────────────────────
# The database every service connects to — set to the Atlas URI in production.
MONGO_URI="mongodb://localhost:27017/linkinlegal?replicaSet=rs0"
# Refresh alias/identifier search fields after externally loaded records arrive.
# Required. UTC schedule; diff-based and protected by the scheduler's distributed lease.
SANCTIONS_SEARCH_NAMES_CRON="0 * * * *"
# The three MONGO_* secrets below are only required by the compose.local-mongo.yml
# testing overlay (Atlas deployments can leave them unset). Generate independent
# passwords with `openssl rand -hex 32`; do not commit real secrets.
MONGO_ROOT_PASSWORD=
# Must be exactly 64 hexadecimal characters: openssl rand -hex 32
MONGO_APP_PASSWORD=
# Generate with: openssl rand -base64 756 | tr -d '\n'
MONGO_REPLICA_SET_KEY=replace-with-a-long-random-replica-set-key

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_SSL=false

# ── Session & auth ──────────────────────────────────────────────────────────
# Must match NEXT_PUBLIC_SESSION_COOKIE_NAME in the corresponding client deployment.
# Environments sharing .linkinlegal.com need different names (for example, linkinlegal.dev.sid).
COOKIE_NAME=linkinlegal.sid
SESSION_SECRET=replace-with-a-long-random-secret
MAX_SESSIONS=3
INTERNAL_API_KEY="replace-with-a-random-internal-api-key"

# --- Meeting notetaker (alaya-main-chat repo, `meeting-bot/`) ----------------
# Where the recording service runs. Leave blank to switch the notetaker off:
# meetings still work, nothing is recorded, and asking for a recording explains
# why rather than failing obscurely.
# Use a reachable address when the service is not on this compose network.
MEETING_BOT_URL="http://meeting-bot:8080"
# Shared secret this API presents to the notetaker service. Must match
# MEETING_BOT_API_TOKEN in the notetaker's own environment.
MEETING_BOT_API_TOKEN="replace-with-a-random-notetaker-token"
# The name the notetaker appears under in a call.
MEETING_BOT_NAME="LinkinLegal Notetaker"
# Where the notetaker posts back what it hears — transcript, attendance, and the
# final report. Defaults to BACKEND_URL + this path, which is right in
# production; set it explicitly only when the notetaker cannot resolve that.
# Get it wrong and nothing appears to break: the bot joins, records, and every
# callback is quietly retried into the void, leaving a meeting with no minutes.
# Locally the notetaker runs in Docker, where "localhost" is the container:
#   MEETING_BOT_CALLBACK_URL="http://host.docker.internal:4000/api/v1/internal/meeting-bot"
MEETING_BOT_CALLBACK_URL=""
# Where a BROWSER can reach the notetaker, for the embedded sign-in screen.
# Falls back to MEETING_BOT_URL, which is right whenever that address is one a
# browser can also reach — set this only when the API talks to the notetaker
# over an address the browser cannot use, such as a private IP.
MEETING_BOT_PUBLIC_URL=""
# --- One container per meeting, on Fargate ------------------------------------
# Filling in the cluster, the task definition and at least one subnet switches
# dispatch from "post the meeting to the shared notetaker service" to "start a
# container for this meeting and stop it when the meeting ends". Leave them
# blank and nothing changes.
#
# MEETING_BOT_URL stays set alongside these: the sign-in screen and voiceprint
# encoding live on the long-running service and belong to no single meeting.
MEETING_BOT_ECS_CLUSTER=""
# Family name, or family:revision to pin. Bare family always runs the newest.
MEETING_BOT_ECS_TASK_DEFINITION=""
# Comma-separated, one per availability zone: a zone short of Fargate capacity
# then costs a retry rather than a recording.
MEETING_BOT_ECS_SUBNETS=""
# Comma-separated. Egress only — nothing ever connects to a notetaker.
MEETING_BOT_ECS_SECURITY_GROUPS=""
# Must match the container name inside the task definition, or the session the
# container is started with is silently dropped and it comes up with no job.
MEETING_BOT_ECS_CONTAINER_NAME="notetaker"
# A notetaker has to reach Google, Zoom and Teams. "true" gives each task a
# public address, which is the cheap way; set "false" only when the tasks run in
# a private subnet behind a NAT gateway.
MEETING_BOT_ECS_ASSIGN_PUBLIC_IP="true"
# The language every transcript is filed in, whatever language was spoken.
# Must match BOT_TRANSCRIPT_LANGUAGE in the notetaker's own environment, or a
# meeting will read differently depending on how it happened to be captured.
# Blank switches it off and leaves every line as spoken.
TRANSCRIPT_LANGUAGE="English"
# Shared secret for on-demand ISR revalidation of the public web app.
# Must match REVALIDATE_SECRET in apps/web. Leave unset to disable.
REVALIDATE_SECRET=""

# ── WorkOS ──────────────────────────────────────────────────────────────────
WORKOS_CLIENT_ID="workos_client_id"
WORKOS_API_KEY="workos_api_key"
WORKOS_ISSUER="https://api.workos.com"
# Claude connector (remote MCP server at /mcp). Unset MCP_AUTHKIT_DOMAIN to turn it off.
# MCP_RESOURCE_URL must equal the Resource Indicator registered in WorkOS; it
# defaults to BACKEND_URL + /mcp.
# MCP_AUTHKIT_DOMAIN="https://your-env.authkit.app"
# MCP_RESOURCE_URL="https://api.example.com/mcp"

# ── AWS S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ── Queues ──────────────────────────────────────────────────────────────────
# Use bullmq for local Node workers. External Lambda/Python queues remain on SQS.
INTERNAL_QUEUE_DRIVER=sqs
SQS_ACCESS_KEY=your-sqs-access-key
SQS_SECRET_KEY=your-sqs-secret-key
SQS_REGION=ap-south-1
DASHBOARD_SQS_QUEUE=https://sqs.ap-south-1.amazonaws.com/000000000000/dashboard-queue
CHAT_FILE_SQS_QUEUE=https://sqs.ap-south-1.amazonaws.com/000000000000/chat-file-queue
SYSTEM_DOCUMENT_PROCESS_SQS_QUEUE=https://sqs.ap-south-1.amazonaws.com/000000000000/system-document-process-queue
CHAT_BOT_SCRAPE_SQS_QUEUE="https://sqs.ap-south-1.amazonaws.com/000000000000/chat-bot-scrape-queue"
SYNC_FILE_PROCESS_SQS_QUEUE="https://sqs.ap-south-1.amazonaws.com/000000000000/sync-file-process-queue"
COMPANY_DOCUMENT_VECTORIZE_SQS_QUEUE="https://sqs.ap-south-1.amazonaws.com/000000000000/company-document-vectorize-queue"
PDF_TRANSLATION_SQS_QUEUE="https://sqs.ap-south-1.amazonaws.com/000000000000/pdf-translation-queue"
PDF_TRANSLATION_WORKER_CONCURRENCY=2
CONTRACT_DRAFTING_SQS_QUEUE="https://sqs.ap-south-1.amazonaws.com/000000000000/contract-drafting-queue"
COMPLIANCE_SQS_QUEUE="https://sqs.ap-south-1.amazonaws.com/000000000000/compliance-queue"
COMPANY_COMPLIANCE_SQS_QUEUE="https://sqs.ap-south-1.amazonaws.com/000000000000/company-compliance-queue"

# ── Email ───────────────────────────────────────────────────────────────────
# Use smtp for direct local delivery; ses keeps the SQS worker path.
EMAIL_PROVIDER=ses
EMAIL_ENABLED=true
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=office@example.com
EMAIL_SECURE=false

# Optional internal alert for newly created accounts.
SIGNUP_SLACK_WEBHOOK_URL="https://hooks.slack.com/services/replace/me"
# The public site's NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN. Leave empty to not record payments in PostHog.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST="https://us.i.posthog.com"
# Mobile app push notifications go through Expo's push service. Set this only if
# "enhanced push security" is on for the Expo project.
# EXPO_ACCESS_TOKEN=

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"
# "1" adds a routerless second API product for the multi-product billing test. Never in production.
API_TEST_PRODUCTS="0"

# ── Pinecone & retrieval ────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=your-pinecone-index-name
PINECONE_USER_INDEX_NAME=your-user-files-pinecone-index-name
PINECONE_CHATBOT_INDEX_NAME="chat-bot"
PINECONE_REGION=us-west-2
RETRIEVAL_RERANK_ENABLED=true
RETRIEVAL_RERANK_MODEL=cohere-rerank-3.5
RETRIEVAL_RERANK_POOL_MULTIPLIER=12
RETRIEVAL_RERANK_POOL_CAP=150
INTERNAL_KNOWLEDGE_CONTRACT_NAMESPACE=contract

# ── AI providers & models ───────────────────────────────────────────────────
AI_PROVIDER="openrouter"
OPENAI_API_KEY="your-openai-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="your-google-generative-ai-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"
COMPANY_CHAT_MODEL="deepseek/deepseek-v4.1-flash"
COMPLIANCE_PROFILE_MODEL="google/gemini-3.7-flash"
COMPLIANCE_LAW_DISCOVERY_MODEL="google/gemini-3.7-flash"
COMPLIANCE_EXTRACTION_MODEL="google/gemini-3.7-flash"
COMPLIANCE_STRUCTURING_MODEL="openai/gpt-5.6-luna"
COMPANY_COMPLIANCE_EXTRACT_MODEL="google/gemini-2.5-flash"
COMPANY_COMPLIANCE_EXTRACT_FALLBACK_MODEL="google/gemini-3.7-flash"

# ── Zoom ────────────────────────────────────────────────────────────────────
ZOOM_CLIENT_ID="your-zoom-client-id"
ZOOM_CLIENT_SECRET="your-zoom-client-secret"
ZOOM_REDIRECT_URI="http://localhost:4000/api/v1/meetings/oauth/zoom/callback"

# ── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Azure / Microsoft ───────────────────────────────────────────────────────
AZURE_CLIENT_ID="your-azure-client-id"
AZURE_CLIENT_SECRET="your-azure-client-secret"
AZURE_AUTHORITY=common
MSAL_ENC_KEY="MzDWtwf/hANFjjXSYDSoSwoveL0GpOiSWizxJ0NSRk8="

# ── OnlyOffice ──────────────────────────────────────────────────────────────
ONLY_OFFICE_API_SECRET="your-only-office-api-secret"
ONLY_OFFICE_NAV_PLUGIN_URL="http://localhost:5174/config.json"
ONLY_OFFICE_NAV_PLUGIN_GUID="asc.{3677A757-E15D-42A9-AA11-6DF063F3B688}"

OPENROUTER_PDF_TRANSLATION_MODEL="openai/gpt-5.6-luna"
OPENROUTER_PDF_TRANSLATION_EFFORT="medium"

OUTREACH_FROM_EMAIL=invitations@marketing.example.com
OUTREACH_FROM_NAME=Example
OUTREACH_CONFIGURATION_SET=outreach

# The sanctions alert sends from its own verified subdomain, apart from
# invitations: a complaint against one mailing must not cost the other its
# delivery. Unset falls back to FROM_EMAIL.
DIGEST_FROM_EMAIL=sanctions@updates.example.com
DIGEST_FROM_NAME=Example
DIGEST_CONFIGURATION_SET=digest
# Daily email of every record added to Sanction Search (15:00 Pakistan time).
# Unset = the team's default list, on production only. Set a list of addresses
# to send elsewhere (any environment), or "off" to stop it.
# LATEST_RECORDS_ALERT_EMAILS=you@example.com
SES_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ses-outreach-events

DRAFT_MODE_MODEL="openai/gpt-6-luna"
