+import type {
+  ComparisonCountriesQuery,
+  ComparisonCountriesResponse,
+  ComparisonDatasetDetail,
+  ComparisonDatasetRow,
+  ComparisonDatasetsResponse,
+  ComparisonJobDto,
+  ComparisonSampleRecord,
+  ComparisonSummaryDto,
+  ComparisonTrigger,
+  IndependentRunDto,
+  UpdateComparisonSourceBody,
+} from "@repo/types/modules/sanctions/comparison";
+import mongoose, { type Types } from "mongoose";
+
+import { NotFoundError } from "@/utils/http-error";
+import { createLogger } from "@/utils/logger";
+
+import { SanctionDatasetDescriptions } from "../models/sanction-dataset-descr.model";
+import { SanctionModel } from "../sanction.model";
+import { collectSideStats, toSideStats, type SideStats } from "./comparison-stats";
+import {
+  ComparisonSnapshotModel,
+  INDEPENDENT_RECORDS,
+  IndependentRunModel,
+  SourceRegistryModel,
+  type IComparisonSnapshot,
+  type IIndependentRun,
+  type ISourceRegistry,
+} from "./comparison.models";
+import {
+  buildDatasetRows,
+  categoryOfTags,
+  countryRows,
+  emptyCategoryCounts,
+  emptyStatusCounts,
+  sideTotals,
+} from "./comparison.pure";
+import inventory from "./source-inventory.json";
+
+const logger = createLogger("sanctions-comparison");
+
+export const INVENTORY_VERSION = inventory.version;
+export const SCRAPER_OWNER = "Abdul Moeed";
+const CALCULATION_VERSION = 1;
+/** A comparison still "running" after this died with its process; another may start. */
+const RUNNING_TIMEOUT_MS = 60 * 60_000;
+const SCAN_MAX_TIME_MS = 30 * 60_000;
+const KEEP_COMPLETE = 14;
+
+type InventorySource = (typeof inventory.sources)[number] & Record<string, unknown>;
+
+/**
+ * Bring the registry in line with the bundled inventory: new sources arrive as
+ * "not started" under the scraper owner; existing ones keep the status people set.
+ */
+export async function syncRegistry(): Promise<void> {
+  const sources = inventory.sources as InventorySource[];
+  await SourceRegistryModel.bulkWrite(
+    sources.map((source) => ({
+      updateOne: {
+        filter: { datasetId: source.id },
+        update: {
+          $set: {
+            inventoryVersion: INVENTORY_VERSION,
+            title: source.title,
+            publisher: source.publisher,
+            publisherAcronym: source.publisherAcronym,
+            official: source.official,
+            issuerCountry: source.issuerCountry,
+            updates: source.updates,
+            category: categoryOfTags(source.tags),
+            tags: source.tags,
+            inventoryEntities: source.inventoryEntities,
+            inventoryTargets: source.inventoryTargets,
+            sourceUrl: source.sourceUrl,
+            sourceDataUrl: source.sourceDataUrl,
+            sourceDataFormat: source.sourceDataFormat,
+            linkCheck: source.linkCheck,
+          },
+          $setOnInsert: { owner: SCRAPER_OWNER, workStatus: "not_started" },
+        },
+        upsert: true,
+      },
+    })),
+    { ordered: false },
+  );
+}
+
+const toJobDto = (doc: IComparisonSnapshot): ComparisonJobDto => ({
+  id: String(doc._id),
+  status: doc.status,
+  trigger: doc.trigger,
+  ...(doc.requestedBy ? { requestedBy: doc.requestedBy } : {}),
+  startedAt: doc.startedAt.toISOString(),
+  ...(doc.finishedAt ? { finishedAt: doc.finishedAt.toISOString() } : {}),
+  ...(doc.durationMs !== undefined ? { durationMs: doc.durationMs } : {}),
+  ...(doc.error ? { error: doc.error } : {}),
+});
+
+/** Mark comparisons whose process died mid-scan as failed, so they stop blocking. */
+async function failAbandoned(): Promise<void> {
+  await ComparisonSnapshotModel.updateMany(
+    { status: "running", startedAt: { $lt: new Date(Date.now() - RUNNING_TIMEOUT_MS) } },
+    { $set: { status: "failed", error: "Stopped before finishing (the process restarted)." } },
+  );
+}
+
+async function runningComparison(): Promise<IComparisonSnapshot | null> {
+  await failAbandoned();
+  return ComparisonSnapshotModel.findOne({ status: "running" })
+    .sort({ startedAt: -1 })
+    .lean<IComparisonSnapshot>();
+}
+
+async function startSnapshot(trigger: ComparisonTrigger, requestedBy?: string) {
+  const doc = await ComparisonSnapshotModel.create({
+    status: "running",
+    trigger,
+    ...(requestedBy ? { requestedBy } : {}),
+    startedAt: new Date(),
+    inventoryVersion: INVENTORY_VERSION,
+    calculationVersion: CALCULATION_VERSION,
+  });
+  return doc.toObject() as IComparisonSnapshot;
+}
+
+/**
+ * Count both sides and store the result. Never called by a page load: the daily
+ * cron, the Refresh button and the import call it. One scan of `sanctions-data`
+ * took 33 s on the 6.4M-record dev copy.
+ */
+export async function runComparison(options: {
+  trigger: ComparisonTrigger;
+  requestedBy?: string;
+  signal?: AbortSignal;
+  /** A snapshot already created as "running" by `requestRefresh`. */
+  snapshotId?: Types.ObjectId;
+}): Promise<IComparisonSnapshot> {
+  const snapshotId =
+    options.snapshotId ?? (await startSnapshot(options.trigger, options.requestedBy))._id;
+  const startedAt = Date.now();
+  try {
+    await syncRegistry();
+    const db = mongoose.connection.db;
+    if (!db) throw new Error("No database connection");
+
+    const baseline = await collectSideStats(db.collection(SanctionModel.collection.name), {
+      maxTimeMS: SCAN_MAX_TIME_MS,
+      signal: options.signal,
+    });
+
+    const current = await SourceRegistryModel.find(
+      { independent: { $exists: true } },
+      { _id: 0, datasetId: 1, "independent.snapshotId": 1 },
+    ).lean<Array<Pick<ISourceRegistry, "datasetId" | "independent">>>();
+    const independentSnapshots = current.flatMap((row) =>
+      row.independent ? [{ datasetId: row.datasetId, snapshotId: row.independent.snapshotId }] : [],
+    );
+    // Only each source's current snapshot counts; rows of an interrupted import do not.
+    const independent: SideStats = independentSnapshots.length
+      ? await collectSideStats(db.collection(INDEPENDENT_RECORDS), {
+          match: { $or: independentSnapshots },
+          maxTimeMS: SCAN_MAX_TIME_MS,
+          signal: options.signal,
+        })
+      : toSideStats(undefined);
+
+    const finishedAt = new Date();
+    const done = await ComparisonSnapshotModel.findByIdAndUpdate(
+      snapshotId,
+      {
+        $set: {
+          status: "complete",
+          finishedAt,
+          durationMs: finishedAt.getTime() - startedAt,
+          independentSnapshots,
+          baseline: { collection: SanctionModel.collection.name, ...baseline },
+          independent: { collection: INDEPENDENT_RECORDS, ...independent },
+        },
+      },
+      { returnDocument: "after" },
+    ).lean<IComparisonSnapshot>();
+    await pruneSnapshots();
+    logger.info(
+      { snapshotId: String(snapshotId), durationMs: finishedAt.getTime() - startedAt },
+      "Sanctions comparison complete",
+    );
+    if (!done) throw new Error("The comparison record disappeared while it ran");
+    return done;
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    await ComparisonSnapshotModel.updateOne(
+      { _id: snapshotId },
+      {
+        $set: {
+          status: "failed",
+          finishedAt: new Date(),
+          durationMs: Date.now() - startedAt,
+          error: message.slice(0, 2000),
+        },
+      },
+    );
+    throw error;
+  }
+}
+
+/** For the cron and the import: count unless a comparison is already running (then null). */
+export async function runComparisonIfIdle(options: {
+  trigger: ComparisonTrigger;
+  requestedBy?: string;
+  signal?: AbortSignal;
+}): Promise<IComparisonSnapshot | null> {
+  if (await runningComparison()) return null;
+  return runComparison(options);
+}
+
+async function pruneSnapshots(): Promise<void> {
+  const keep = await ComparisonSnapshotModel.find({ status: "complete" }, { _id: 1 })
+    .sort({ startedAt: -1 })
+    .limit(KEEP_COMPLETE)
+    .lean<Array<{ _id: Types.ObjectId }>>();
+  const oldestKept = keep.at(-1);
+  if (keep.length < KEEP_COMPLETE || !oldestKept) return;
+  const cutoff = await ComparisonSnapshotModel.findById(oldestKept._id, { startedAt: 1 }).lean<
+    Pick<IComparisonSnapshot, "startedAt">
+  >();
+  if (!cutoff) return;
+  await ComparisonSnapshotModel.deleteMany({
+    status: { $ne: "running" },
+    startedAt: { $lt: cutoff.startedAt },
+  });
+}
+
+/** The Refresh button: start one comparison in the background, or report the one running. */
+export async function requestRefresh(requestedBy?: string): Promise<ComparisonJobDto> {
+  const running = await runningComparison();
+  if (running) return toJobDto(running);
+  const snapshot = await startSnapshot("manual", requestedBy);
+  void runComparison({ trigger: "manual", requestedBy, snapshotId: snapshot._id }).catch((error) =>
+    logger.error({ error }, "Manual sanctions comparison failed"),
+  );
+  return toJobDto(snapshot);
+}
+
+/* ---------------------------------- reads --------------------------------- */
+
+let cachedSnapshot: IComparisonSnapshot | undefined;
+
+/** The newest complete comparison; its ~0.5 MB body is read once per new comparison. */
+async function latestComplete(): Promise<IComparisonSnapshot | null> {
+  const newest = await ComparisonSnapshotModel.findOne({ status: "complete" }, { _id: 1 })
+    .sort({ startedAt: -1 })
+    .lean<{ _id: Types.ObjectId }>();
+  if (!newest) return null;
+  if (cachedSnapshot && String(cachedSnapshot._id) === String(newest._id)) return cachedSnapshot;
+  const doc = await ComparisonSnapshotModel.findById(newest._id).lean<IComparisonSnapshot>();
+  if (doc) cachedSnapshot = doc;
+  return doc;
+}
+
+let cachedTitles: { at: number; titles: Map<string, string> } | undefined;
+
+async function datasetTitles(): Promise<Map<string, string>> {
+  if (cachedTitles && Date.now() - cachedTitles.at < 60 * 60_000) return cachedTitles.titles;
+  const rows = await SanctionDatasetDescriptions.find({}, { _id: 0, name: 1, description: 1 }).lean<
+    Array<{ name: string; description: string }>
+  >();
+  const titles = new Map(rows.map((row) => [row.name, row.description]));
+  cachedTitles = { at: Date.now(), titles };
+  return titles;
+}
+
+async function registryRows(): Promise<ISourceRegistry[]> {
+  let rows = await SourceRegistryModel.find({}).sort({ datasetId: 1 }).lean<ISourceRegistry[]>();
+  if (rows.length === 0) {
+    // First visit before any comparison ran: show the work queue anyway.
+    await syncRegistry();
+    rows = await SourceRegistryModel.find({}).sort({ datasetId: 1 }).lean<ISourceRegistry[]>();
+  }
+  return rows;
+}
+
+async function allDatasetRows(snapshot: IComparisonSnapshot | null) {
+  const [registry, titles] = await Promise.all([registryRows(), datasetTitles()]);
+  return {
+    registry,
+    rows: buildDatasetRows({
+      registry,
+      baseline: snapshot?.baseline,
+      independent: snapshot?.independent,
+      titles,
+    }),
+  };
+}
+
+export async function getSummary(): Promise<ComparisonSummaryDto> {
+  const [snapshot, registry, newestAttempt] = await Promise.all([
+    latestComplete(),
+    registryRows(),
+    (async () => {
+      await failAbandoned();
+      return ComparisonSnapshotModel.findOne(
+        {},
+        {
+          status: 1,
+          trigger: 1,
+          requestedBy: 1,
+          startedAt: 1,
+          finishedAt: 1,
+          durationMs: 1,
+          error: 1,
+        },
+      )
+        .sort({ startedAt: -1 })
+        .lean<IComparisonSnapshot>();
+    })(),
+  ]);
+
+  const byStatus = emptyStatusCounts();
+  const byCategory = emptyCategoryCounts();
+  for (const row of registry) {
+    byStatus[row.workStatus] += 1;
+    byCategory[row.category] += 1;
+  }
+
+  return {
+    comparison: snapshot ? toJobDto(snapshot) : null,
+    latestAttempt:
+      newestAttempt && String(newestAttempt._id) !== String(snapshot?._id)
+        ? toJobDto(newestAttempt)
+        : null,
+    inventory: {
+      version: INVENTORY_VERSION,
+      sources: registry.length,
+      byStatus,
+      byCategory,
+    },
+    baseline: sideTotals(snapshot?.baseline),
+    independent: sideTotals(snapshot?.independent),
+  };
+}
+
+export async function listDatasets(): Promise<ComparisonDatasetsResponse> {
+  const snapshot = await latestComplete();
+  const { rows } = await allDatasetRows(snapshot);
+  return {
+    comparisonId: snapshot ? String(snapshot._id) : null,
+    generatedAt: snapshot?.finishedAt?.toISOString() ?? null,
+    rows,
+  };
+}
+
+export async function listCountries(
+  query: ComparisonCountriesQuery,
+): Promise<ComparisonCountriesResponse> {
+  const snapshot = await latestComplete();
+  let datasets: Set<string> | undefined;
+  if (query.dataset) {
+    datasets = new Set([query.dataset]);
+  } else if (query.category) {
+    const { rows } = await allDatasetRows(snapshot);
+    datasets = new Set(
+      rows.filter((row) => row.category === query.category).map((row) => row.datasetId),
+    );
+  }
+  const result = countryRows({
+    baseline: snapshot?.baseline,
+    independent: snapshot?.independent,
+    datasets,
+  });
+  return {
+    comparisonId: snapshot ? String(snapshot._id) : null,
+    generatedAt: snapshot?.finishedAt?.toISOString() ?? null,
+    ...result,
+  };
+}
+
+const toRunDto = (run: IIndependentRun): IndependentRunDto => ({
+  id: String(run._id),
+  datasetId: run.datasetId,
+  snapshotId: run.snapshotId,
+  status: run.status,
+  ...(run.adapterVersion ? { adapterVersion: run.adapterVersion } : {}),
+  receivedAt: run.receivedAt.toISOString(),
+  finishedAt: run.finishedAt.toISOString(),
+  durationMs: run.durationMs,
+  ...(run.rows !== undefined ? { rows: run.rows } : {}),
+  ...(run.bytes !== undefined ? { bytes: run.bytes } : {}),
+  ...(run.fetchCompletedAt ? { fetchCompletedAt: run.fetchCompletedAt.toISOString() } : {}),
+  ...(run.publishedAt !== undefined
+    ? { publishedAt: run.publishedAt ? run.publishedAt.toISOString() : null }
+    : {}),
+  ...(run.sourceTotal !== undefined ? { sourceTotal: run.sourceTotal } : {}),
+  errors: run.issues ?? [],
+});
+
+type SampleSource = {
+  id: string;
+  caption?: string;
+  schema?: string;
+  datasets?: string[];
+  last_change?: string;
+  properties?: { country?: string[] };
+};
+
+const toSample = (record: SampleSource): ComparisonSampleRecord => ({
+  id: record.id,
+  caption: record.caption ?? "",
+  schema: record.schema ?? "",
+  datasets: record.datasets ?? [],
+  countries: record.properties?.country ?? [],
+  ...(record.last_change ? { lastChange: record.last_change } : {}),
+});
+
+const SAMPLE_FIELDS = {
+  _id: 0,
+  id: 1,
+  caption: 1,
+  schema: 1,
+  datasets: 1,
+  last_change: 1,
+  "properties.country": 1,
+};
+
+async function samples(datasetId: string, snapshotId?: string) {
+  const db = mongoose.connection.db;
+  if (!db) return { baseline: [], independent: [] };
+  // `target` leads every dataset index, so naming both values lets the read use one.
+  const baseline = db
+    .collection(SanctionModel.collection.name)
+    .find({ target: { $in: [true, false] }, datasets: datasetId }, { projection: SAMPLE_FIELDS })
+    .limit(5)
+    .maxTimeMS(5_000)
+    .toArray()
+    .catch((error) => {
+      logger.warn({ error, datasetId }, "Baseline sample read failed");
+      return [];
+    });
+  const independent = snapshotId
+    ? db
+        .collection(INDEPENDENT_RECORDS)
+        .find({ datasetId, snapshotId }, { projection: SAMPLE_FIELDS })
+        .limit(5)
+        .maxTimeMS(5_000)
+        .toArray()
+    : Promise.resolve([]);
+  const [base, ours] = await Promise.all([baseline, independent]);
+  return {
+    baseline: (base as unknown as SampleSource[]).map(toSample),
+    independent: (ours as unknown as SampleSource[]).map(toSample),
+  };
+}
+
+export async function getDatasetDetail(datasetId: string): Promise<ComparisonDatasetDetail> {
+  const snapshot = await latestComplete();
+  const { registry, rows } = await allDatasetRows(snapshot);
+  const row = rows.find((candidate) => candidate.datasetId === datasetId);
+  if (!row)
+    throw new NotFoundError({ message: `No source ${datasetId} in the inventory or the data` });
+  const source = registry.find((candidate) => candidate.datasetId === datasetId);
+
+  const [runs, sampleRecords] = await Promise.all([
+    IndependentRunModel.find({ datasetId })
+      .sort({ receivedAt: -1 })
+      .limit(20)
+      .lean<IIndependentRun[]>(),
+    samples(datasetId, source?.independent?.snapshotId),
+  ]);
+
+  return {
+    comparisonId: snapshot ? String(snapshot._id) : null,
+    generatedAt: snapshot?.finishedAt?.toISOString() ?? null,
+    row,
+    source: source
+      ? {
+          owner: source.owner,
+          ...(source.notes ? { notes: source.notes } : {}),
+          ...(source.statusUpdatedAt
+            ? { statusUpdatedAt: source.statusUpdatedAt.toISOString() }
+            : {}),
+          ...(source.statusUpdatedBy ? { statusUpdatedBy: source.statusUpdatedBy } : {}),
+          ...(source.sourceUrl ? { sourceUrl: source.sourceUrl } : {}),
+          ...(source.sourceDataUrl ? { sourceDataUrl: source.sourceDataUrl } : {}),
+          ...(source.sourceDataFormat ? { sourceDataFormat: source.sourceDataFormat } : {}),
+          tags: source.tags ?? [],
+          ...(source.linkCheck ? { linkCheck: source.linkCheck } : {}),
+          ...(source.lastError ? { lastError: source.lastError } : {}),
+          ...(source.lastFailedAt ? { lastFailedAt: source.lastFailedAt.toISOString() } : {}),
+        }
+      : null,
+    countries: countryRows({
+      baseline: snapshot?.baseline,
+      independent: snapshot?.independent,
+      datasets: new Set([datasetId]),
+    }).rows,
+    runs: runs.map(toRunDto),
+    samples: sampleRecords,
+  };
+}
+
+export async function updateSource(
+  datasetId: string,
+  body: UpdateComparisonSourceBody,
+  updatedBy?: string,
+): Promise<ComparisonDatasetRow["workStatus"]> {
+  const $set: Record<string, unknown> = {};
+  const $unset: Record<string, ""> = {};
+  if (body.workStatus) {
+    $set.workStatus = body.workStatus;
+    $set.statusUpdatedAt = new Date();
+    if (updatedBy) $set.statusUpdatedBy = updatedBy;
+  }
+  for (const field of ["blocker", "notes"] as const) {
+    const value = body[field];
+    if (value === undefined) continue;
+    if (value) $set[field] = value;
+    else $unset[field] = "";
+  }
+  const updated = await SourceRegistryModel.findOneAndUpdate(
+    { datasetId },
+    {
+      ...(Object.keys($set).length ? { $set } : {}),
+      ...(Object.keys($unset).length ? { $unset } : {}),
+    },
+    { returnDocument: "after", projection: { workStatus: 1 } },
+  ).lean<Pick<ISourceRegistry, "workStatus">>();
+  if (!updated) throw new NotFoundError({ message: `No inventory source ${datasetId}` });
+  return updated.workStatus;
+}
