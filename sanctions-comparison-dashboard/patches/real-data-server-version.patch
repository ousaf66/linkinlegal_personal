diff --git a/apps/server/src/scripts/import-independent-sanctions.ts b/apps/server/src/scripts/import-independent-sanctions.ts
new file mode 100644
index 000000000..a0e47999b
--- /dev/null
+++ b/apps/server/src/scripts/import-independent-sanctions.ts
@@ -0,0 +1,90 @@
+import "dotenv/config";
+
+import { readdir, stat } from "node:fs/promises";
+import { dirname, join, resolve } from "node:path";
+
+import mongoose from "mongoose";
+
+import { runComparisonIfIdle } from "@/modules/sanction-pep/comparison/comparison.service";
+import { importIndependentDelivery } from "@/modules/sanction-pep/comparison/independent-import.service";
+
+/**
+ * Import scraper deliveries into `sanction-independent-records`, then recount
+ * the comparison dashboard.
+ *
+ *     pnpm sanctions:import-independent <folder> [<folder> …]
+ *
+ * A folder is one delivery (it holds `manifest.json`) or any folder above
+ * deliveries, e.g. `independent/`, which is searched for every `manifest.json`.
+ * COMPARE=false skips the recount. Writes only the comparison collections; never
+ * `sanctions-data`. Exits 1 when any delivery was rejected.
+ */
+
+async function deliveries(path: string): Promise<string[]> {
+  const root = resolve(path);
+  if ((await stat(root)).isFile()) return [dirname(root)];
+  const entries = await readdir(root, { recursive: true });
+  const found = entries
+    .filter((entry) => entry === "manifest.json" || entry.endsWith("/manifest.json"))
+    .map((entry) => dirname(join(root, entry)))
+    .sort();
+  return found;
+}
+
+async function main(): Promise<number> {
+  const args = process.argv.slice(2);
+  if (!args.length) {
+    console.error("usage: pnpm sanctions:import-independent <folder> [<folder> …]");
+    return 2;
+  }
+  await mongoose.connect(process.env.MONGO_URI!);
+
+  const folders = (await Promise.all(args.map(deliveries))).flat();
+  if (!folders.length) {
+    console.error("No manifest.json found under", args.join(", "));
+    return 2;
+  }
+
+  let imported = 0;
+  let rejected = 0;
+  for (const folder of folders) {
+    const outcome = await importIndependentDelivery(folder);
+    const label = `${outcome.datasetId ?? "?"}/${outcome.snapshotId ?? "?"}`;
+    if (outcome.status === "imported") {
+      imported += 1;
+      console.log(
+        `imported  ${label}: ${outcome.rows} records (${outcome.replaced} old rows removed)`,
+      );
+    } else if (outcome.status === "failed") {
+      console.log(
+        `failed    ${label}: the scraper reported "${outcome.error}" (recorded, data unchanged)`,
+      );
+    } else {
+      rejected += 1;
+      console.log(`rejected  ${label} (${folder}):`);
+      for (const issue of outcome.issues) console.log(`  - ${issue}`);
+    }
+  }
+
+  if (imported && process.env.COMPARE !== "false") {
+    console.log("recounting the comparison…");
+    const snapshot = await runComparisonIfIdle({ trigger: "import" });
+    console.log(
+      snapshot
+        ? `comparison ${String(snapshot._id)} complete in ${Math.round((snapshot.durationMs ?? 0) / 1000)} s`
+        : "a comparison is already running; it will not include these imports — press Refresh after it",
+    );
+  }
+  return rejected ? 1 : 0;
+}
+
+main()
+  .then(async (code) => {
+    await mongoose.disconnect();
+    process.exit(code);
+  })
+  .catch(async (error) => {
+    console.error(error);
+    await mongoose.disconnect();
+    process.exit(1);
+  });
diff --git a/packages/types/src/modules/sanctions/comparison.ts b/packages/types/src/modules/sanctions/comparison.ts
