@@ -0,0 +1,346 @@
+import { createHash } from "node:crypto";
+import { createReadStream } from "node:fs";
+import { readFile, stat } from "node:fs/promises";
+import { join, resolve, sep } from "node:path";
+import { createInterface } from "node:readline";
+
+import {
+  independentManifestSchema,
+  independentRecordSchema,
+  type IndependentManifest,
+  type IndependentRecord,
+  type WorkStatus,
+} from "@repo/types/modules/sanctions/comparison";
+import mongoose from "mongoose";
+import type { AnyBulkWriteOperation } from "mongodb";
+
+import {
+  INDEPENDENT_RECORDS,
+  IndependentRunModel,
+  SourceRegistryModel,
+  independentRecordIndexes,
+  type ISourceRegistry,
+} from "./comparison.models";
+import { syncRegistry } from "./comparison.service";
+
+const MAX_ISSUES = 20;
+const BATCH = 1000;
+const MAX_MANIFEST_BYTES = 1_000_000;
+
+/** A successful import moves an unfinished source to "validated"; it never demotes one. */
+const PROMOTED_FROM = new Set<WorkStatus>(["not_started", "in_progress", "blocked", "delivered"]);
+
+export type ImportOutcome =
+  | { status: "imported"; datasetId: string; snapshotId: string; rows: number; replaced: number }
+  | { status: "failed"; datasetId: string; snapshotId: string; error: string }
+  | { status: "rejected"; datasetId?: string; snapshotId?: string; issues: string[] };
+
+type FilePass = { rows: number; bytes: number; sha256: string };
+
+/**
+ * Read one payload file line by line, hashing exactly the bytes on disk.
+ * `onRecord` sees each valid record; problems are collected, not thrown.
+ */
+async function readPayload(
+  path: string,
+  datasetId: string,
+  issues: string[],
+  onRecord: (record: IndependentRecord, line: number) => void | Promise<void>,
+): Promise<FilePass> {
+  const hash = createHash("sha256");
+  let bytes = 0;
+  let rows = 0;
+  let line = 0;
+  const stream = createReadStream(path);
+  stream.on("data", (chunk) => {
+    const buffer = typeof chunk === "string" ? Buffer.from(chunk) : chunk;
+    hash.update(buffer);
+    bytes += buffer.length;
+  });
+  const name = path.split(sep).at(-1);
+  for await (const text of createInterface({ input: stream, crlfDelay: Infinity })) {
+    line += 1;
+    if (!text.trim()) continue;
+    rows += 1;
+    let value: unknown;
+    try {
+      value = JSON.parse(text);
+    } catch {
+      if (issues.length < MAX_ISSUES) issues.push(`${name}:${line}: not valid JSON`);
+      continue;
+    }
+    const parsed = independentRecordSchema.safeParse(value);
+    if (!parsed.success) {
+      if (issues.length < MAX_ISSUES) {
+        const first = parsed.error.issues[0];
+        issues.push(`${name}:${line}: ${first?.path.join(".") || "record"}: ${first?.message}`);
+      }
+      continue;
+    }
+    const datasets = parsed.data.datasets;
+    if (datasets && datasets.length && !datasets.includes(datasetId)) {
+      if (issues.length < MAX_ISSUES) {
+        issues.push(`${name}:${line}: datasets does not include ${datasetId}`);
+      }
+      continue;
+    }
+    await onRecord(parsed.data, line);
+  }
+  return { rows, bytes, sha256: hash.digest("hex") };
+}
+
+function checkFile(
+  file: IndependentManifest["files"][number],
+  pass: FilePass,
+  issues: string[],
+): void {
+  if (pass.sha256 !== file.sha256) issues.push(`${file.path}: SHA-256 differs from the manifest`);
+  if (pass.bytes !== file.bytes) {
+    issues.push(`${file.path}: ${pass.bytes} bytes on disk, manifest says ${file.bytes}`);
+  }
+  if (pass.rows !== file.rows) {
+    issues.push(`${file.path}: ${pass.rows} rows, manifest says ${file.rows}`);
+  }
+}
+
+async function recordRun(
+  manifest: Partial<IndependentManifest> & { datasetId: string; snapshotId: string },
+  status: "imported" | "rejected" | "failed",
+  receivedAt: Date,
+  extra: { rows?: number; bytes?: number; issues?: string[] },
+) {
+  const finishedAt = new Date();
+  await IndependentRunModel.create({
+    datasetId: manifest.datasetId,
+    snapshotId: manifest.snapshotId,
+    ...(manifest.runId ? { runId: manifest.runId } : {}),
+    status,
+    ...(manifest.adapterVersion ? { adapterVersion: manifest.adapterVersion } : {}),
+    receivedAt,
+    finishedAt,
+    durationMs: finishedAt.getTime() - receivedAt.getTime(),
+    ...(extra.rows !== undefined ? { rows: extra.rows } : {}),
+    ...(extra.bytes !== undefined ? { bytes: extra.bytes } : {}),
+    ...(manifest.fetchStartedAt ? { fetchStartedAt: new Date(manifest.fetchStartedAt) } : {}),
+    ...(manifest.fetchCompletedAt ? { fetchCompletedAt: new Date(manifest.fetchCompletedAt) } : {}),
+    ...(manifest.publishedAt !== undefined
+      ? { publishedAt: manifest.publishedAt ? new Date(manifest.publishedAt) : null }
+      : {}),
+    ...(manifest.sourceTotal !== undefined ? { sourceTotal: manifest.sourceTotal } : {}),
+    ...(manifest.counts ? { counts: manifest.counts } : {}),
+    ...(manifest.sourceUrls?.length ? { sourceUrls: manifest.sourceUrls } : {}),
+    issues: extra.issues ?? [],
+  });
+  if (status !== "imported") {
+    await SourceRegistryModel.updateOne(
+      { datasetId: manifest.datasetId },
+      {
+        $set: {
+          lastFailedAt: finishedAt,
+          lastError: (extra.issues ?? []).slice(0, 3).join("; ").slice(0, 1000),
+        },
+      },
+    );
+  }
+}
+
+/**
+ * Import one delivery folder (`manifest.json` + its JSONL files) into
+ * `sanction-independent-records`.
+ *
+ * All or nothing for the source: every file is checked first (hash, size, rows,
+ * each record, unique IDs); only a clean delivery is written, under its own
+ * snapshot ID, and only then named the source's current snapshot and the
+ * previous snapshot's rows removed. A rejected or failed delivery is recorded
+ * and changes no data. Re-importing the same snapshot writes the same rows.
+ */
+export async function importIndependentDelivery(folder: string): Promise<ImportOutcome> {
+  const receivedAt = new Date();
+  const dir = resolve(folder);
+  const manifestPath = join(dir, "manifest.json");
+
+  let raw: unknown;
+  try {
+    const info = await stat(manifestPath);
+    if (info.size > MAX_MANIFEST_BYTES) {
+      return { status: "rejected", issues: [`manifest.json is over ${MAX_MANIFEST_BYTES} bytes`] };
+    }
+    raw = JSON.parse(await readFile(manifestPath, "utf8"));
+  } catch (error) {
+    return {
+      status: "rejected",
+      issues: [`manifest.json: ${error instanceof Error ? error.message : String(error)}`],
+    };
+  }
+
+  await syncRegistry();
+  const parsed = independentManifestSchema.safeParse(raw);
+  const named = raw as { datasetId?: unknown; snapshotId?: unknown };
+  const datasetId = typeof named?.datasetId === "string" ? named.datasetId : undefined;
+  const snapshotId = typeof named?.snapshotId === "string" ? named.snapshotId : undefined;
+  const source = datasetId
+    ? await SourceRegistryModel.findOne({ datasetId }).lean<ISourceRegistry>()
+    : null;
+
+  if (!parsed.success) {
+    const issues = parsed.error.issues
+      .slice(0, MAX_ISSUES)
+      .map((issue) => `manifest.${issue.path.join(".")}: ${issue.message}`);
+    if (source && datasetId && snapshotId) {
+      await recordRun({ datasetId, snapshotId }, "rejected", receivedAt, { issues });
+    }
+    return { status: "rejected", datasetId, snapshotId, issues };
+  }
+  const manifest = parsed.data;
+  if (!source) {
+    return {
+      status: "rejected",
+      datasetId: manifest.datasetId,
+      snapshotId: manifest.snapshotId,
+      issues: [`${manifest.datasetId} is not in the source inventory`],
+    };
+  }
+
+  if (manifest.status === "failed") {
+    const error = manifest.error ?? "The scraper reported a failure";
+    await recordRun(manifest, "failed", receivedAt, { issues: [error] });
+    return {
+      status: "failed",
+      datasetId: manifest.datasetId,
+      snapshotId: manifest.snapshotId,
+      error,
+    };
+  }
+
+  const current = source.independent;
+  if (
+    current &&
+    current.snapshotId !== manifest.snapshotId &&
+    current.fetchCompletedAt &&
+    manifest.fetchCompletedAt &&
+    new Date(manifest.fetchCompletedAt) < current.fetchCompletedAt
+  ) {
+    const issues = [
+      `fetched ${manifest.fetchCompletedAt}, before the current snapshot ${current.snapshotId} (${current.fetchCompletedAt.toISOString()})`,
+    ];
+    await recordRun(manifest, "rejected", receivedAt, { issues });
+    return {
+      status: "rejected",
+      datasetId: manifest.datasetId,
+      snapshotId: manifest.snapshotId,
+      issues,
+    };
+  }
+
+  // Pass 1: check everything before writing anything.
+  const issues: string[] = [];
+  const ids = new Set<string>();
+  let totalBytes = 0;
+  const paths = new Map<string, string>();
+  for (const file of manifest.files) {
+    const path = resolve(dir, file.path);
+    if (!path.startsWith(dir + sep)) {
+      issues.push(`${file.path}: outside the delivery folder`);
+      continue;
+    }
+    paths.set(file.path, path);
+    let pass: FilePass;
+    try {
+      pass = await readPayload(path, manifest.datasetId, issues, (record, line) => {
+        if (ids.has(record.id)) {
+          if (issues.length < MAX_ISSUES)
+            issues.push(`${file.path}:${line}: duplicate id ${record.id}`);
+        } else ids.add(record.id);
+      });
+    } catch (error) {
+      issues.push(`${file.path}: ${error instanceof Error ? error.message : String(error)}`);
+      continue;
+    }
+    totalBytes += pass.bytes;
+    checkFile(file, pass, issues);
+  }
+  if (issues.length) {
+    await recordRun(manifest, "rejected", receivedAt, { issues: issues.slice(0, MAX_ISSUES) });
+    return {
+      status: "rejected",
+      datasetId: manifest.datasetId,
+      snapshotId: manifest.snapshotId,
+      issues: issues.slice(0, MAX_ISSUES),
+    };
+  }
+
+  // Pass 2: write under the delivery's own snapshot ID.
+  const db = mongoose.connection.db;
+  if (!db) throw new Error("No database connection");
+  const records = db.collection(INDEPENDENT_RECORDS);
+  for (const index of independentRecordIndexes) {
+    await records.createIndex(index.key, { name: index.name, unique: index.unique });
+  }
+  const scope = { datasetId: manifest.datasetId, snapshotId: manifest.snapshotId };
+  let batch: AnyBulkWriteOperation[] = [];
+  const flush = async () => {
+    if (!batch.length) return;
+    const ops = batch;
+    batch = [];
+    await records.bulkWrite(ops, { ordered: false });
+  };
+  for (const file of manifest.files) {
+    const path = paths.get(file.path)!;
+    const pass = await readPayload(path, manifest.datasetId, issues, async (record) => {
+      // One delivery is one source: its records count for that source alone.
+      const doc = { ...record, datasets: [manifest.datasetId], ...scope };
+      batch.push({
+        replaceOne: { filter: { ...scope, id: record.id }, replacement: doc, upsert: true },
+      });
+      if (batch.length >= BATCH) await flush();
+    });
+    checkFile(file, pass, issues);
+  }
+  await flush();
+  if (issues.length) {
+    // The file changed between the passes. Drop what this snapshot wrote unless it is current.
+    if (current?.snapshotId !== manifest.snapshotId) await records.deleteMany(scope);
+    await recordRun(manifest, "rejected", receivedAt, { issues: issues.slice(0, MAX_ISSUES) });
+    return {
+      status: "rejected",
+      datasetId: manifest.datasetId,
+      snapshotId: manifest.snapshotId,
+      issues: issues.slice(0, MAX_ISSUES),
+    };
+  }
+
+  // Promote, then remove every other snapshot of the source (older ones, or a half-written one).
+  await SourceRegistryModel.updateOne(
+    { datasetId: manifest.datasetId },
+    {
+      $set: {
+        independent: {
+          snapshotId: manifest.snapshotId,
+          records: ids.size,
+          importedAt: new Date(),
+          ...(manifest.fetchCompletedAt
+            ? { fetchCompletedAt: new Date(manifest.fetchCompletedAt) }
+            : {}),
+          publishedAt: manifest.publishedAt ? new Date(manifest.publishedAt) : null,
+          adapterVersion: manifest.adapterVersion,
+        },
+        ...(PROMOTED_FROM.has(source.workStatus)
+          ? { workStatus: "validated", statusUpdatedAt: new Date(), statusUpdatedBy: "import" }
+          : {}),
+      },
+      $unset: { lastError: "", lastFailedAt: "" },
+    },
+  );
+  const removed = await records.deleteMany({
+    datasetId: manifest.datasetId,
+    snapshotId: { $ne: manifest.snapshotId },
+  });
+  await recordRun(manifest, "imported", receivedAt, { rows: ids.size, bytes: totalBytes });
+  return {
+    status: "imported",
+    datasetId: manifest.datasetId,
+    snapshotId: manifest.snapshotId,
+    rows: ids.size,
+    replaced: removed.deletedCount,
+  };
+}
diff --git a/apps/server/src/modules/sanction-pep/comparison/independent-import.test.ts b/apps/server/src/modules/sanction-pep/comparison/independent-import.test.ts
new file mode 100644
index 000000000..604982917
--- /dev/null
+++ b/apps/server/src/modules/sanction-pep/comparison/independent-import.test.ts
@@ -0,0 +1,295 @@
+import "dotenv/config";
+
+import assert from "node:assert/strict";
+import { createHash } from "node:crypto";
+import { mkdtemp, mkdir, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { after, before, beforeEach, test } from "node:test";
+
+import mongoose from "mongoose";
+
+import {
+  ComparisonSnapshotModel,
+  INDEPENDENT_RECORDS,
+  IndependentRunModel,
+  SourceRegistryModel,
+} from "./comparison.models";
+import {
+  getDatasetDetail,
+  getSummary,
+  listCountries,
+  listDatasets,
+  runComparison,
+  updateSource,
+} from "./comparison.service";
+import { importIndependentDelivery } from "./independent-import.service";
+
+/**
+ * Wipes the comparison collections and writes `sanctions-data` fixtures, so it
+ * runs only against a throwaway local MongoDB (`pnpm test:db:local`), never the
+ * shared dev database a plain `pnpm test:db` points at.
+ */
+const uri = process.env.MONGO_URI ?? "";
+const LOCAL = /^mongodb:\/\/(127\.0\.0\.1|localhost)[:/]/.test(uri);
+const skip = LOCAL ? false : "needs a local MongoDB (pnpm test:db:local)";
+
+const DATASET = "us_ofac_sdn";
+const FIXTURE_IDS = ["llg-fixture-1", "llg-fixture-2", "llg-fixture-3"];
+let root: string;
+
+const db = () => mongoose.connection.db!;
+
+async function delivery(
+  snapshotId: string,
+  records: object[],
+  patch: Record<string, unknown> = {},
+): Promise<string> {
+  const dir = join(root, DATASET, snapshotId);
+  await mkdir(dir, { recursive: true });
+  const body = records.map((record) => JSON.stringify(record)).join("\n") + "\n";
+  await writeFile(join(dir, "entities.ftm.jsonl"), body);
+  const manifest = {
+    contractVersion: 1,
+    provider: "independent",
+    datasetId: DATASET,
+    snapshotId,
+    adapterVersion: "test@1",
+    status: "success",
+    fetchStartedAt: "2026-11-12T04:00:00Z",
+    fetchCompletedAt: "2026-11-12T04:05:00Z",
+    complete: true,
+    counts: { extracted: records.length, accepted: records.length, rejected: 0, duplicates: 0 },
+    files: [
+      {
+        path: "entities.ftm.jsonl",
+        sha256: createHash("sha256").update(body).digest("hex"),
+        bytes: Buffer.byteLength(body),
+        rows: records.length,
+      },
+    ],
+    ...patch,
+  };
+  await writeFile(join(dir, "manifest.json"), JSON.stringify(manifest));
+  return dir;
+}
+
+const person = (id: string, country?: string) => ({
+  id,
+  caption: id,
+  schema: "Person",
+  properties: { name: [id], ...(country ? { country: [country] } : {}) },
+  datasets: [DATASET],
+  target: true,
+});
+
+const sanction = (id: string, entity: string) => ({
+  id,
+  caption: "OFAC SDN",
+  schema: "Sanction",
+  properties: { entity: [entity], authority: ["OFAC"] },
+});
+
+before(async () => {
+  if (!LOCAL) return;
+  await mongoose.connect(uri);
+  root = await mkdtemp(join(tmpdir(), "independent-import-"));
+});
+
+after(async () => {
+  if (!LOCAL) return;
+  if (root) await rm(root, { recursive: true, force: true });
+  await mongoose.disconnect();
+});
+
+beforeEach(async () => {
+  if (!LOCAL) return;
+  await Promise.all([
+    SourceRegistryModel.deleteMany({}),
+    IndependentRunModel.deleteMany({}),
+    ComparisonSnapshotModel.deleteMany({}),
+    db().collection(INDEPENDENT_RECORDS).deleteMany({}),
+    db()
+      .collection("sanctions-data")
+      .deleteMany({ id: { $in: FIXTURE_IDS } }),
+  ]);
+});
+
+test(
+  "a clean delivery is imported, replayed idempotently, and replaced by the next",
+  { skip },
+  async () => {
+    const first = await delivery("s1", [
+      person("p1", "ir"),
+      person("p2", "ru"),
+      sanction("s-p1", "p1"),
+    ]);
+    const outcome = await importIndependentDelivery(first);
+    assert.equal(outcome.status, "imported");
+    assert.equal(outcome.status === "imported" && outcome.rows, 3);
+
+    const source = await SourceRegistryModel.findOne({ datasetId: DATASET }).lean();
+    assert.equal(source?.independent?.snapshotId, "s1");
+    assert.equal(
+      source?.workStatus,
+      "validated",
+      "an import moves a not-started source to validated",
+    );
+    assert.equal(await db().collection(INDEPENDENT_RECORDS).countDocuments(), 3);
+
+    // The same snapshot again changes nothing.
+    const replay = await importIndependentDelivery(first);
+    assert.equal(replay.status, "imported");
+    assert.equal(
+      await db().collection(INDEPENDENT_RECORDS).countDocuments({ snapshotId: "s1" }),
+      3,
+    );
+
+    // A newer snapshot replaces the old one's rows completely.
+    const second = await delivery("s2", [person("p1", "ir")], {
+      fetchCompletedAt: "2026-11-13T04:05:00Z",
+    });
+    const next = await importIndependentDelivery(second);
+    assert.equal(next.status === "imported" && next.replaced, 3);
+    assert.deepEqual(await db().collection(INDEPENDENT_RECORDS).distinct("snapshotId"), ["s2"]);
+
+    // An older fetch cannot roll the source back.
+    const stale = await delivery("s0", [person("p9")], {
+      fetchCompletedAt: "2026-11-01T00:00:00Z",
+    });
+    const refused = await importIndependentDelivery(stale);
+    assert.equal(refused.status, "rejected");
+    assert.equal(
+      (await SourceRegistryModel.findOne({ datasetId: DATASET }).lean())?.independent?.snapshotId,
+      "s2",
+    );
+  },
+);
+
+test("a bad delivery is recorded and changes no data", { skip }, async () => {
+  await importIndependentDelivery(await delivery("good", [person("p1")]));
+
+  const tampered = await delivery("bad-hash", [person("p1"), person("p2")], {
+    files: [{ path: "entities.ftm.jsonl", sha256: "0".repeat(64), bytes: 1, rows: 2 }],
+  });
+  const hash = await importIndependentDelivery(tampered);
+  assert.equal(hash.status, "rejected");
+  assert.ok(hash.status === "rejected" && hash.issues.some((issue) => issue.includes("SHA-256")));
+
+  const dupes = await importIndependentDelivery(
+    await delivery("dupes", [person("p1"), person("p1"), { ...person("NK-x"), id: "NK-x" }]),
+  );
+  assert.ok(
+    dupes.status === "rejected" && dupes.issues.some((issue) => issue.includes("duplicate id p1")),
+  );
+  assert.ok(dupes.status === "rejected" && dupes.issues.some((issue) => issue.includes("NK-")));
+
+  const failed = await importIndependentDelivery(
+    await delivery("down", [], {
+      status: "failed",
+      error: "HTTP 503 from the publisher",
+      files: [],
+      counts: { extracted: 0, accepted: 0, rejected: 0, duplicates: 0 },
+    }),
+  );
+  assert.equal(failed.status, "failed");
+
+  const unknown = await importIndependentDelivery(
+    await delivery("x", [person("p1")], { datasetId: "not_a_source" }),
+  );
+  assert.equal(unknown.status, "rejected");
+
+  assert.deepEqual(await db().collection(INDEPENDENT_RECORDS).distinct("snapshotId"), ["good"]);
+  const runs = await IndependentRunModel.find({ datasetId: DATASET })
+    .sort({ receivedAt: 1 })
+    .lean();
+  assert.deepEqual(
+    runs.map((run) => run.status),
+    ["imported", "rejected", "rejected", "failed"],
+  );
+  const source = await SourceRegistryModel.findOne({ datasetId: DATASET }).lean();
+  assert.equal(source?.lastError, "HTTP 503 from the publisher");
+  assert.equal(source?.independent?.snapshotId, "good", "a failure keeps the last good snapshot");
+});
+
+test("the comparison counts both sides and the reads serve it", { skip }, async () => {
+  await db()
+    .collection("sanctions-data")
+    .insertMany([
+      {
+        id: FIXTURE_IDS[0],
+        schema: "Person",
+        caption: "A",
+        datasets: [DATASET],
+        target: true,
+        properties: { country: ["ir", "IR"] },
+      },
+      {
+        id: FIXTURE_IDS[1],
+        schema: "Company",
+        caption: "B",
+        datasets: [DATASET, "zz_only_in_the_feed"],
+        target: true,
+        properties: {},
+      },
+      {
+        id: FIXTURE_IDS[2],
+        schema: "Sanction",
+        caption: "C",
+        datasets: [DATASET],
+        target: true,
+        properties: { entity: [FIXTURE_IDS[0]] },
+      },
+    ]);
+  await importIndependentDelivery(
+    await delivery("s1", [person("p1", "ir"), sanction("s-p1", "p1")]),
+  );
+  // Rows of an interrupted import under another snapshot must not be counted.
+  await db()
+    .collection(INDEPENDENT_RECORDS)
+    .insertOne({ ...person("ghost", "ru"), datasetId: DATASET, snapshotId: "half-written" });
+
+  const snapshot = await runComparison({ trigger: "manual" });
+  assert.equal(snapshot.status, "complete");
+  const base = snapshot.baseline!.datasets.find((row) => row.id === DATASET);
+  assert.deepEqual([base?.records, base?.entities], [3, 2]);
+  const ours = snapshot.independent!.datasets.find((row) => row.id === DATASET);
+  assert.deepEqual([ours?.records, ours?.entities], [2, 1]);
+
+  const summary = await getSummary();
+  assert.equal(summary.comparison?.id, String(snapshot._id));
+  assert.equal(summary.inventory.sources, 477);
+  assert.equal(summary.inventory.byStatus.validated, 1);
+  assert.equal(summary.independent?.records, 2);
+
+  const { rows } = await listDatasets();
+  assert.equal(rows.filter((row) => row.inInventory).length, 477);
+  const ofac = rows.find((row) => row.datasetId === DATASET);
+  assert.equal(ofac?.baseline?.entities, 2);
+  assert.equal(ofac?.independent?.entities, 1);
+  assert.equal(ofac?.independent?.snapshotId, "s1");
+  assert.ok(rows.some((row) => row.datasetId === "zz_only_in_the_feed" && !row.inInventory));
+
+  const countries = await listCountries({});
+  assert.deepEqual(
+    countries.rows.find((row) => row.code === "ir"),
+    { code: "ir", baseline: 1, independent: 1 },
+  );
+  assert.equal(
+    countries.rows.find((row) => row.code === "ru"),
+    undefined,
+    "the ghost row is not counted",
+  );
+
+  const detail = await getDatasetDetail(DATASET);
+  assert.equal(detail.runs[0]?.status, "imported");
+  assert.equal(detail.samples.independent.length, 2);
+  assert.equal(detail.samples.baseline.length, 3);
+
+  assert.equal(
+    await updateSource(DATASET, { workStatus: "searchable", blocker: "" }, "admin@example.com"),
+    "searchable",
+  );
+  const updated = await SourceRegistryModel.findOne({ datasetId: DATASET }).lean();
+  assert.equal(updated?.statusUpdatedBy, "admin@example.com");
+});
