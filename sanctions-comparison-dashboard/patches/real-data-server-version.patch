@@ -0,0 +1,98 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import {
+  independentManifestSchema,
+  independentRecordSchema,
+} from "@repo/types/modules/sanctions/comparison";
+
+const SHA = "a".repeat(64);
+
+const success = {
+  contractVersion: 1,
+  provider: "independent",
+  datasetId: "us_ofac_sdn",
+  snapshotId: "2026-11-12T0400Z",
+  adapterVersion: "ofac-sdn@1.0.0",
+  status: "success",
+  sourceUrls: [
+    "https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML",
+  ],
+  publishedAt: null,
+  fetchStartedAt: "2026-11-12T04:00:00Z",
+  fetchCompletedAt: "2026-11-12T04:03:10+00:00",
+  complete: true,
+  sourceTotal: 18000,
+  counts: { extracted: 75800, accepted: 75798, rejected: 2, duplicates: 0 },
+  files: [{ path: "entities.ftm.jsonl", sha256: SHA, bytes: 1234, rows: 75798 }],
+};
+
+const problems = (value: unknown) => {
+  const parsed = independentManifestSchema.safeParse(value);
+  return parsed.success ? [] : parsed.error.issues.map((issue) => issue.path.join("."));
+};
+
+test("a complete successful delivery is accepted", () => {
+  assert.deepEqual(problems(success), []);
+});
+
+test("a failed run must say why it failed", () => {
+  const failed = {
+    ...success,
+    status: "failed",
+    files: [],
+    counts: { ...success.counts, accepted: 0 },
+  };
+  assert.deepEqual(problems(failed), ["error"]);
+  assert.deepEqual(problems({ ...failed, error: "HTTP 503 from the publisher" }), []);
+});
+
+test("partial snapshots, row mismatches and missing payloads are refused", () => {
+  assert.deepEqual(problems({ ...success, complete: false }), ["complete"]);
+  assert.deepEqual(problems({ ...success, counts: { ...success.counts, accepted: 5 } }), [
+    "counts.accepted",
+  ]);
+  assert.ok(
+    problems({ ...success, files: [], counts: { ...success.counts, accepted: 0 } }).includes(
+      "files",
+    ),
+  );
+  assert.ok(problems({ ...success, fetchCompletedAt: undefined }).includes("fetchCompletedAt"));
+});
+
+test("payload files are names beside the manifest, never paths out of it", () => {
+  for (const path of ["../entities.jsonl", "/tmp/x.jsonl", "sub/x.jsonl", "x.json"]) {
+    assert.ok(
+      problems({ ...success, files: [{ ...success.files[0], path }] }).length > 0,
+      `${path} must be refused`,
+    );
+  }
+});
+
+test("dataset IDs are inventory IDs and the version is pinned", () => {
+  assert.ok(problems({ ...success, datasetId: "US OFAC" }).includes("datasetId"));
+  assert.ok(problems({ ...success, contractVersion: 2 }).includes("contractVersion"));
+});
+
+test("records are FtM entities with string-array properties and our own IDs", () => {
+  const record = {
+    id: "llg-us-ofac-sdn-36",
+    caption: "AEROCARIBBEAN AIRLINES",
+    schema: "Organization",
+    properties: { name: ["AEROCARIBBEAN AIRLINES"], country: ["cu"] },
+    datasets: ["us_ofac_sdn"],
+    target: true,
+    first_seen: "2026-11-12T04:03:10",
+  };
+  assert.ok(independentRecordSchema.safeParse(record).success);
+  assert.ok(!independentRecordSchema.safeParse({ ...record, id: "NK-abc" }).success);
+  assert.ok(!independentRecordSchema.safeParse({ ...record, schema: "organization" }).success);
+  assert.ok(
+    !independentRecordSchema.safeParse({ ...record, properties: { name: "AEROCARIBBEAN" } })
+      .success,
+  );
+  // An identifier keeps its leading zeros: it is a string, never a number.
+  assert.ok(
+    !independentRecordSchema.safeParse({ ...record, properties: { idNumber: [7] } }).success,
+  );
+});
diff --git a/apps/server/src/modules/sanction-pep/comparison/comparison-stats.ts b/apps/server/src/modules/sanction-pep/comparison/comparison-stats.ts
new file mode 100644
index 000000000..423821d6c
--- /dev/null
+++ b/apps/server/src/modules/sanction-pep/comparison/comparison-stats.ts
@@ -0,0 +1,195 @@
+import type { Collection, Document } from "mongodb";
+
+import { NOT_PARTIES } from "../sanction-lists";
+
+/** Stored for entities with no `properties.country`, so they stay countable. */
+export const UNKNOWN_COUNTRY = "unknown";
+
+export interface DatasetStats {
+  id: string;
+  /** Every record naming the dataset: parties and the statements about them. */
+  records: number;
+  /** Parties only (people, companies, vessels…), not Sanction/Address/Ownership rows. */
+  entities: number;
+  bytes: number;
+  lastChange?: string;
+  lastSeen?: string;
+}
+
+export interface SideStats {
+  totals: { records: number; entities: number; bytes: number };
+  datasets: DatasetStats[];
+  /** Distinct parties per entity country; a two-country party counts in both. */
+  countries: Array<{ code: string; entities: number }>;
+  /** Parties per (dataset, country), for the per-source and per-category views. */
+  datasetCountries: Array<{ d: string; c: string; n: number }>;
+}
+
+// Codes folded to lower case and de-duplicated per record, so a party listed
+// as both "ir" and "IR" counts once; a record with none is "unknown".
+const countriesOf = {
+  $let: {
+    vars: {
+      c: {
+        $setUnion: [
+          {
+            $filter: {
+              input: {
+                $map: {
+                  input: {
+                    $cond: [{ $isArray: "$properties.country" }, "$properties.country", []],
+                  },
+                  in: { $toLower: { $trim: { input: { $toString: "$$this" } } } },
+                },
+              },
+              cond: { $ne: ["$$this", ""] },
+            },
+          },
+          [],
+        ],
+      },
+    },
+    in: { $cond: [{ $eq: [{ $size: "$$c" }, 0] }, [UNKNOWN_COUNTRY], "$$c"] },
+  },
+};
+
+/**
+ * One collection scan that yields every number the dashboard shows for one side.
+ *
+ * `$facet` reads each record once and feeds the four groupings, so the cost is a
+ * single pass over the collection however many views the page has. The page never
+ * runs this: the job does, and stores the result.
+ */
+export function statsPipeline(match?: Document): Document[] {
+  return [
+    ...(match ? [{ $match: match }] : []),
+    {
+      $project: {
+        _id: 0,
+        datasets: { $ifNull: ["$datasets", []] },
+        last_change: 1,
+        last_seen: 1,
+        e: { $cond: [{ $in: ["$schema", NOT_PARTIES] }, 0, 1] },
+        c: countriesOf,
+        size: { $bsonSize: "$$ROOT" },
+      },
+    },
+    {
+      $facet: {
+        totals: [
+          {
+            $group: {
+              _id: null,
+              records: { $sum: 1 },
+              entities: { $sum: "$e" },
+              bytes: { $sum: "$size" },
+            },
+          },
+        ],
+        datasets: [
+          { $unwind: "$datasets" },
+          {
+            $group: {
+              _id: "$datasets",
+              records: { $sum: 1 },
+              entities: { $sum: "$e" },
+              bytes: { $sum: "$size" },
+              lastChange: { $max: "$last_change" },
+              lastSeen: { $max: "$last_seen" },
+            },
+          },
+        ],
+        countries: [
+          { $match: { e: 1 } },
+          { $unwind: "$c" },
+          { $group: { _id: "$c", entities: { $sum: 1 } } },
+        ],
+        datasetCountries: [
+          { $match: { e: 1 } },
+          { $unwind: "$datasets" },
+          { $unwind: "$c" },
+          { $group: { _id: { d: "$datasets", c: "$c" }, n: { $sum: 1 } } },
+        ],
+      },
+    },
+  ];
+}
+
+type FacetResult = {
+  totals: Array<{ records: number; entities: number; bytes: number }>;
+  datasets: Array<
+    Omit<DatasetStats, "id" | "lastChange" | "lastSeen"> & {
+      _id: string;
+      lastChange?: string | null;
+      lastSeen?: string | null;
+    }
+  >;
+  countries: Array<{ _id: string | null; entities: number }>;
+  datasetCountries: Array<{ _id: { d: string; c: string | null }; n: number }>;
+};
+
+const countryKey = (code: string | null | undefined) =>
+  typeof code === "string" && code.trim() ? code.trim().toLowerCase() : UNKNOWN_COUNTRY;
+
+/** Shape the raw `$facet` output; country codes are folded to lower case and merged. */
+export function toSideStats(raw: FacetResult | undefined): SideStats {
+  const totals = raw?.totals[0] ?? { records: 0, entities: 0, bytes: 0 };
+
+  const countries = new Map<string, number>();
+  for (const row of raw?.countries ?? []) {
+    const key = countryKey(row._id);
+    countries.set(key, (countries.get(key) ?? 0) + row.entities);
+  }
+
+  const pairs = new Map<string, { d: string; c: string; n: number }>();
+  for (const row of raw?.datasetCountries ?? []) {
+    const c = countryKey(row._id.c);
+    const key = `${row._id.d}\u0000${c}`;
+    const pair = pairs.get(key);
+    if (pair) pair.n += row.n;
+    else pairs.set(key, { d: row._id.d, c, n: row.n });
+  }
+
+  return {
+    totals: { records: totals.records, entities: totals.entities, bytes: totals.bytes },
+    datasets: (raw?.datasets ?? [])
+      .filter((row) => typeof row._id === "string" && row._id)
+      .map((row) => ({
+        id: row._id,
+        records: row.records,
+        entities: row.entities,
+        bytes: row.bytes,
+        ...(row.lastChange ? { lastChange: row.lastChange } : {}),
+        ...(row.lastSeen ? { lastSeen: row.lastSeen } : {}),
+      }))
+      .sort((a, b) => a.id.localeCompare(b.id)),
+    countries: [...countries]
+      .map(([code, entities]) => ({ code, entities }))
+      .sort((a, b) => b.entities - a.entities),
+    datasetCountries: [...pairs.values()].sort((a, b) =>
+      a.d === b.d ? b.n - a.n : a.d.localeCompare(b.d),
+    ),
+  };
+}
+
+export async function collectSideStats(
+  collection: Collection,
+  options: { match?: Document; maxTimeMS: number; signal?: AbortSignal },
+): Promise<SideStats> {
+  const cursor = collection.aggregate<FacetResult>(statsPipeline(options.match), {
+    allowDiskUse: true,
+    maxTimeMS: options.maxTimeMS,
+    // A full scan: run it on a secondary so it never competes with live searches
+    // on the primary. A single-node database falls back to the primary.
+    readPreference: "secondaryPreferred",
+  });
+  const abort = () => void cursor.close();
+  options.signal?.addEventListener("abort", abort, { once: true });
+  try {
+    const [raw] = await cursor.toArray();
+    options.signal?.throwIfAborted();
+    return toSideStats(raw);
+  } finally {
+    options.signal?.removeEventListener("abort", abort);
+  }
+}
diff --git a/apps/server/src/modules/sanction-pep/comparison/comparison.cron.ts b/apps/server/src/modules/sanction-pep/comparison/comparison.cron.ts
