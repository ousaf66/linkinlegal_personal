+"use client";
+
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
+import { AlertTriangleIcon, LoaderCircleIcon, RefreshCwIcon } from "lucide-react";
+import { toast } from "sonner";
+
+import { Button } from "@/components/ui/button";
+import { Skeleton } from "@/components/ui/skeleton";
+import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/components/ui/tabs";
+import { cn } from "@/lib/utils";
+import { useAuthContext } from "@/modules/authmodule/context/auth.provider";
+
+import { comparisonKeys, errorMessage, fetchDatasets, fetchSummary, postRefresh } from "./api";
+import { CountriesTable } from "./countries-table";
+import { fmtAgo, fmtDate } from "./format";
+import { SourceSheet } from "./source-sheet";
+import { SourcesTable } from "./sources-table";
+import { SummaryPanel } from "./summary-panel";
+import { WorkQueue } from "./work-queue";
+
+type Tab = "sources" | "countries" | "queue";
+
+function Notice({
+  tone = "neutral",
+  title,
+  children,
+}: {
+  tone?: "neutral" | "danger";
+  title: string;
+  children?: ReactNode;
+}) {
+  return (
+    <div
+      role={tone === "danger" ? "alert" : "status"}
+      className={cn(
+        "flex gap-3 rounded-lg border px-4 py-3 text-sm",
+        tone === "danger" ? "border-destructive/40 bg-destructive/5" : "bg-muted/40",
+      )}
+    >
+      <AlertTriangleIcon
+        className={cn(
+          "mt-0.5 size-4 shrink-0",
+          tone === "danger" ? "text-destructive" : "text-muted-foreground",
+        )}
+      />
+      <div className="space-y-0.5">
+        <p className="font-medium">{title}</p>
+        {children ? <div className="text-muted-foreground">{children}</div> : null}
+      </div>
+    </div>
+  );
+}
+
+/**
+ * The OpenSanctions feed we load today beside what our own scrapers deliver,
+ * source by source and country by country. Every number comes from one stored
+ * comparison, counted by a daily job or "Recount now", never on page load.
+ */
+function ComparisonDashboard() {
+  const queryClient = useQueryClient();
+  const [tab, setTab] = useState<Tab>("sources");
+  const [issuer, setIssuer] = useState<string | null>(null);
+  const [selected, setSelected] = useState<string | null>(null);
+
+  const summaryQuery = useQuery({
+    queryKey: comparisonKeys.summary(),
+    queryFn: fetchSummary,
+    refetchInterval: (query) =>
+      query.state.data?.latestAttempt?.status === "running" ? 5_000 : false,
+  });
+  const summary = summaryQuery.data;
+  const comparisonId = summary?.comparison?.id ?? null;
+  const running = summary?.latestAttempt?.status === "running";
+  const failed = summary?.latestAttempt?.status === "failed" ? summary.latestAttempt : null;
+
+  const datasetsQuery = useQuery({
+    queryKey: comparisonKeys.datasets(comparisonId),
+    queryFn: fetchDatasets,
+    enabled: !!summary,
+    staleTime: 60_000,
+  });
+
+  // When a recount finishes, say so once.
+  const wasRunning = useRef(false);
+  useEffect(() => {
+    if (wasRunning.current && !running && summary) {
+      if (summary.latestAttempt?.status === "failed") toast.error("The recount failed");
+      else toast.success("Comparison recounted");
+    }
+    wasRunning.current = running;
+  }, [running, summary]);
+
+  const refresh = useMutation({
+    mutationFn: postRefresh,
+    onSuccess: async () => {
+      await queryClient.invalidateQueries({ queryKey: comparisonKeys.summary() });
+    },
+    onError: (error) => toast.error(errorMessage(error)),
+  });
+
+  const comparison = summary?.comparison;
+
+  return (
+    <div className="flex flex-col gap-4">
+      <div className="flex flex-wrap items-start gap-3">
+        <div className="mr-auto flex flex-col gap-1">
+          <h1 className="text-lg font-semibold">Sanctions comparison</h1>
+          <p className="max-w-3xl text-sm text-muted-foreground">
+            The OpenSanctions feed we load today beside the sources our own scrapers deliver: how
+            many parties each holds, source by source and country by country.
+          </p>
+        </div>
+        <div className="flex flex-col items-end gap-1">
+          <Button
+            variant="outline"
+            size="sm"
+            disabled={running || refresh.isPending || !summary}
+            onClick={() => refresh.mutate()}
+          >
+            {running ? (
+              <LoaderCircleIcon data-icon="inline-start" className="animate-spin" />
+            ) : (
+              <RefreshCwIcon data-icon="inline-start" />
+            )}
+            {running ? "Recounting…" : "Recount now"}
+          </Button>
+          <span className="text-xs text-muted-foreground">
+            {running && summary?.latestAttempt
+              ? `Started ${fmtAgo(summary.latestAttempt.startedAt)}; this takes about a minute.`
+              : comparison
+                ? `Counted ${fmtAgo(comparison.finishedAt)} · ${fmtDate(comparison.finishedAt)}${comparison.durationMs ? ` · took ${Math.round(comparison.durationMs / 1000)} s` : ""}`
+                : summary
+                  ? "Not counted yet."
+                  : ""}
+          </span>
+        </div>
+      </div>
+
+      {summaryQuery.isError ? (
+        <Notice tone="danger" title="Could not load the comparison">
+          {errorMessage(summaryQuery.error)}
+        </Notice>
+      ) : null}
+
+      {failed ? (
+        <Notice title={`The last recount failed ${fmtAgo(failed.finishedAt ?? failed.startedAt)}`}>
+          {failed.error ?? "No reason was recorded."}{" "}
+          {comparison ? "The numbers below are from the last recount that finished." : ""}
+        </Notice>
+      ) : null}
+
+      {summary && !comparison && !running ? (
+        <Notice title="Nothing counted yet">
+          The comparison is counted every day at 06:30. Press “Recount now” to count it now (about a
+          minute); the sources below are the inventory waiting for scrapers.
+        </Notice>
+      ) : null}
+
+      {summaryQuery.isError ? null : (
+        <SummaryPanel summary={summary} isLoading={summaryQuery.isLoading} />
+      )}
+
+      <Tabs value={tab} onValueChange={(value) => setTab(value as Tab)}>
+        <TabsList variant="line">
+          <TabsTrigger value="sources">Sources</TabsTrigger>
+          <TabsTrigger value="countries">Countries</TabsTrigger>
+          <TabsTrigger value="queue">Work queue</TabsTrigger>
+        </TabsList>
+        <TabsContent value="sources" className="pt-3">
+          <SourcesTable
+            rows={datasetsQuery.data?.rows ?? []}
+            isLoading={datasetsQuery.isLoading || summaryQuery.isLoading}
+            isError={datasetsQuery.isError || summaryQuery.isError}
+            issuerCountry={issuer}
+            onClearIssuer={() => setIssuer(null)}
+            onOpen={setSelected}
+          />
+        </TabsContent>
+        <TabsContent value="countries" className="pt-3">
+          <CountriesTable comparisonId={comparisonId} datasets={datasetsQuery.data?.rows ?? []} />
+        </TabsContent>
+        <TabsContent value="queue" className="pt-3">
+          <WorkQueue
+            rows={datasetsQuery.data?.rows ?? []}
+            isLoading={datasetsQuery.isLoading || summaryQuery.isLoading}
+            onPickCountry={(country) => {
+              setIssuer(country);
+              setTab("sources");
+            }}
+          />
+        </TabsContent>
+      </Tabs>
+
+      <SourceSheet
+        datasetId={selected}
+        comparisonId={comparisonId}
+        onClose={() => setSelected(null)}
+      />
+    </div>
+  );
+}
+
+/**
+ * A page of its own, outside the customer app shell. Signing in is required (the
+ * proxy sends anyone else to /login); only staff (`role: admin`) see the tool,
+ * and the API refuses everyone else whatever this page shows.
+ */
+export function ScraperInternalPage() {
+  const { user, isUserLoading } = useAuthContext();
+  const isStaff = user?.role === "admin";
+
+  return (
+    <div className="min-h-svh bg-background">
+      <header className="border-b">
+        <div className="mx-auto flex h-14 max-w-[1400px] items-center gap-3 px-4">
+          <span className="font-semibold">LinkinLegal</span>
+          <span className="text-sm text-muted-foreground">Scraper internal</span>
+          {user?.email ? (
+            <span className="ml-auto truncate text-xs text-muted-foreground">{user.email}</span>
+          ) : null}
+        </div>
+      </header>
+      <main className="mx-auto max-w-[1400px] px-4 py-6">
+        {isUserLoading ? (
+          <div className="space-y-4">
+            <Skeleton className="h-8 w-64" />
+            <Skeleton className="h-44 w-full" />
+          </div>
+        ) : isStaff ? (
+          <ComparisonDashboard />
+        ) : (
+          <Notice title="LinkinLegal staff only">
+            This internal tool needs an admin account. Sign in with your staff account to use it.
+          </Notice>
+        )}
+      </main>
+    </div>
+  );
+}
