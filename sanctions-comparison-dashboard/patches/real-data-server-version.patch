@@ -0,0 +1,67 @@
+import { isAxiosError } from "axios";
+
+import type {
+  ComparisonCountriesQuery,
+  ComparisonCountriesResponse,
+  ComparisonDatasetDetail,
+  ComparisonDatasetsResponse,
+  ComparisonJobDto,
+  ComparisonSummaryDto,
+  UpdateComparisonSourceBody,
+  WorkStatus,
+} from "@repo/types/modules/sanctions/comparison";
+
+import api from "@/lib/axios";
+
+/** The API's admin-only comparison routes; the server refuses anyone who is not staff. */
+const BASE = "/admin/sanctions-comparison";
+
+export const comparisonKeys = {
+  all: ["scraper-internal"] as const,
+  summary: () => [...comparisonKeys.all, "summary"] as const,
+  datasets: (comparisonId: string | null) =>
+    [...comparisonKeys.all, "datasets", comparisonId] as const,
+  countries: (comparisonId: string | null, query: ComparisonCountriesQuery) =>
+    [...comparisonKeys.all, "countries", comparisonId, query] as const,
+  detail: (datasetId: string) => [...comparisonKeys.all, "detail", datasetId] as const,
+};
+
+/** The server's own message ("Forbidden", "Validation failed"…) rather than axios's. */
+export function errorMessage(error: unknown) {
+  if (isAxiosError<{ message?: string }>(error)) {
+    if (error.response?.status === 401) return "Your session has expired. Sign in again.";
+    if (error.response?.status === 403) return "This tool is for LinkinLegal staff only.";
+    return error.response?.data?.message ?? error.message;
+  }
+  return error instanceof Error ? error.message : String(error);
+}
+
+type Envelope<T> = { data: T };
+
+export const fetchSummary = async () =>
+  (await api.get<Envelope<ComparisonSummaryDto>>(`${BASE}/summary`)).data.data;
+
+export const fetchDatasets = async () =>
+  (await api.get<Envelope<ComparisonDatasetsResponse>>(`${BASE}/datasets`)).data.data;
+
+export const fetchCountries = async (query: ComparisonCountriesQuery) =>
+  (await api.get<Envelope<ComparisonCountriesResponse>>(`${BASE}/countries`, { params: query }))
+    .data.data;
+
+export const fetchDetail = async (datasetId: string) =>
+  (
+    await api.get<Envelope<ComparisonDatasetDetail>>(
+      `${BASE}/datasets/${encodeURIComponent(datasetId)}`,
+    )
+  ).data.data;
+
+export const patchSource = async (datasetId: string, body: UpdateComparisonSourceBody) =>
+  (
+    await api.patch<Envelope<{ workStatus: WorkStatus }>>(
+      `${BASE}/sources/${encodeURIComponent(datasetId)}`,
+      body,
+    )
+  ).data.data;
+
+export const postRefresh = async () =>
+  (await api.post<Envelope<ComparisonJobDto>>(`${BASE}/refresh`)).data.data;
