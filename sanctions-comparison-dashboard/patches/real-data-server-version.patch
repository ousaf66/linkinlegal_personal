+++ b/apps/server/src/modules/sanction-pep/comparison/comparison.cron.ts
@@ -0,0 +1,38 @@
+import Cron, { type ScheduledTask } from "node-cron";
+
+import { recordCronRun } from "@/modules/cron-runs/cron-run.service";
+import type { CronJobRunner } from "@/utils/cron-lease";
+import { createLogger } from "@/utils/logger";
+
+import { runComparisonIfIdle } from "./comparison.service";
+
+const logger = createLogger("sanctions-comparison-cron");
+
+export function initSanctionsComparisonCronJobs(runJob: CronJobRunner): ScheduledTask[] {
+  // Once a day, after the 05:00 listings check. One scan of `sanctions-data`
+  // (33 s on the dev copy) plus our scrapers' records; the dashboard reads the
+  // stored result, and an import or the Refresh button recounts in between.
+  const task = Cron.schedule(
+    "30 6 * * *",
+    async () =>
+      runJob("sanctions-comparison", async (signal) => {
+        await recordCronRun("sanctions-comparison", async () => {
+          try {
+            const snapshot = await runComparisonIfIdle({ trigger: "cron", signal });
+            if (!snapshot) return { skipped: "a comparison was already running" };
+            return {
+              snapshotId: String(snapshot._id),
+              baselineRecords: snapshot.baseline?.totals.records ?? 0,
+              independentRecords: snapshot.independent?.totals.records ?? 0,
+            };
+          } catch (error) {
+            logger.error({ error }, "Sanctions comparison failed");
+            throw error;
+          }
+        });
+      }),
+    { noOverlap: true },
+  );
+
+  return [task];
+}
diff --git a/apps/server/src/modules/sanction-pep/comparison/comparison.models.ts b/apps/server/src/modules/sanction-pep/comparison/comparison.models.ts
new file mode 100644
index 000000000..318a8f295
--- /dev/null
+++ b/apps/server/src/modules/sanction-pep/comparison/comparison.models.ts
@@ -0,0 +1,226 @@
+import {
+  SOURCE_CATEGORIES,
+  WORK_STATUSES,
+  type ComparisonJobStatus,
+  type ComparisonTrigger,
+  type IndependentRunStatus,
+  type SourceCategory,
+  type WorkStatus,
+} from "@repo/types/modules/sanctions/comparison";
+import mongoose, { Schema, type Types } from "mongoose";
+
+import type { SideStats } from "./comparison-stats";
+
+/**
+ * Where the comparison lives. None of these is read by search: `sanctions-data`
+ * stays the loader's, and our scrapers' records sit apart until a separate,
+ * deliberate switch.
+ *
+ * - `sanction-source-registry`     one row per inventory source: its work status and
+ *                                  the scraper's current snapshot.
+ * - `sanction-independent-records` our scrapers' records, FtM, tagged with source + snapshot.
+ * - `sanction-independent-runs`    every delivery: imported, rejected or failed, and why.
+ * - `sanction-comparison-snapshots` the dashboard's numbers, computed by a job, so the
+ *                                  page never counts the big collections itself.
+ */
+
+export interface ISourceRegistry {
+  _id: Types.ObjectId;
+  datasetId: string;
+  inventoryVersion: string;
+  title: string;
+  publisher?: string;
+  publisherAcronym?: string;
+  official?: boolean;
+  issuerCountry?: string;
+  updates?: string;
+  category: SourceCategory;
+  tags: string[];
+  inventoryEntities?: number;
+  inventoryTargets?: number;
+  sourceUrl?: string;
+  sourceDataUrl?: string;
+  sourceDataFormat?: string;
+  linkCheck?: string;
+  owner: string;
+  workStatus: WorkStatus;
+  blocker?: string;
+  notes?: string;
+  statusUpdatedAt?: Date;
+  statusUpdatedBy?: string;
+  independent?: {
+    snapshotId: string;
+    records: number;
+    importedAt: Date;
+    fetchCompletedAt?: Date;
+    publishedAt?: Date | null;
+    adapterVersion?: string;
+  };
+  lastFailedAt?: Date;
+  lastError?: string;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+const sourceRegistrySchema = new Schema<ISourceRegistry>(
+  {
+    datasetId: { type: String, required: true, unique: true },
+    inventoryVersion: { type: String, required: true },
+    title: { type: String, required: true },
+    publisher: String,
+    publisherAcronym: String,
+    official: Boolean,
+    issuerCountry: String,
+    updates: String,
+    category: { type: String, enum: SOURCE_CATEGORIES, required: true },
+    tags: { type: [String], default: [] },
+    inventoryEntities: Number,
+    inventoryTargets: Number,
+    sourceUrl: String,
+    sourceDataUrl: String,
+    sourceDataFormat: String,
+    linkCheck: String,
+    owner: { type: String, required: true },
+    workStatus: { type: String, enum: WORK_STATUSES, default: "not_started" },
+    blocker: String,
+    notes: String,
+    statusUpdatedAt: Date,
+    statusUpdatedBy: String,
+    independent: {
+      type: new Schema(
+        {
+          snapshotId: { type: String, required: true },
+          records: { type: Number, required: true },
+          importedAt: { type: Date, required: true },
+          fetchCompletedAt: Date,
+          publishedAt: { type: Date, default: null },
+          adapterVersion: String,
+        },
+        { _id: false },
+      ),
+      default: undefined,
+    },
+    lastFailedAt: Date,
+    lastError: String,
+  },
+  { timestamps: true },
+);
+
+export const SourceRegistryModel = mongoose.model<ISourceRegistry>(
+  "SanctionSourceRegistry",
+  sourceRegistrySchema,
+  "sanction-source-registry",
+);
+
+export interface IIndependentRun {
+  _id: Types.ObjectId;
+  datasetId: string;
+  snapshotId: string;
+  runId?: string;
+  status: IndependentRunStatus;
+  adapterVersion?: string;
+  receivedAt: Date;
+  finishedAt: Date;
+  durationMs: number;
+  rows?: number;
+  bytes?: number;
+  fetchStartedAt?: Date;
+  fetchCompletedAt?: Date;
+  publishedAt?: Date | null;
+  sourceTotal?: number | null;
+  counts?: { extracted: number; accepted: number; rejected: number; duplicates: number };
+  sourceUrls?: string[];
+  /** Why a delivery was rejected or failed; empty for an import. */
+  issues: string[];
+}
+
+const independentRunSchema = new Schema<IIndependentRun>({
+  datasetId: { type: String, required: true },
+  snapshotId: { type: String, required: true },
+  runId: String,
+  status: { type: String, enum: ["imported", "rejected", "failed"], required: true },
+  adapterVersion: String,
+  receivedAt: { type: Date, required: true },
+  finishedAt: { type: Date, required: true },
+  durationMs: { type: Number, required: true },
+  rows: Number,
+  bytes: Number,
+  fetchStartedAt: Date,
+  fetchCompletedAt: Date,
+  publishedAt: { type: Date, default: undefined },
+  sourceTotal: { type: Number, default: undefined },
+  counts: {
+    type: new Schema(
+      { extracted: Number, accepted: Number, rejected: Number, duplicates: Number },
+      { _id: false },
+    ),
+    default: undefined,
+  },
+  sourceUrls: { type: [String], default: undefined },
+  issues: { type: [String], default: [] },
+});
+
+independentRunSchema.index({ datasetId: 1, receivedAt: -1 }, { name: "dataset_received" });
+
+export const IndependentRunModel = mongoose.model<IIndependentRun>(
+  "SanctionIndependentRun",
+  independentRunSchema,
+  "sanction-independent-runs",
+);
+
+/**
+ * Our scrapers' records. Written only by the import, with the raw driver (no
+ * mongoose model): it is the same FtM shape as `sanctions-data`, plus
+ * `datasetId` and `snapshotId`. Only the snapshot the registry names as current
+ * counts; a run that stopped half-way leaves rows the next import removes.
+ */
+export const INDEPENDENT_RECORDS = "sanction-independent-records";
+
+export const independentRecordIndexes = [
+  {
+    key: { datasetId: 1, snapshotId: 1, id: 1 },
+    name: "dataset_snapshot_id",
+    unique: true,
+  },
+] as const;
+
+export interface IComparisonSnapshot {
+  _id: Types.ObjectId;
+  status: ComparisonJobStatus;
+  trigger: ComparisonTrigger;
+  requestedBy?: string;
+  startedAt: Date;
+  finishedAt?: Date;
+  durationMs?: number;
+  error?: string;
+  inventoryVersion: string;
+  calculationVersion: number;
+  /** The independent snapshots this comparison counted, per source. */
+  independentSnapshots?: Array<{ datasetId: string; snapshotId: string }>;
+  baseline?: SideStats & { collection: string };
+  independent?: SideStats & { collection: string };
+}
+
+const comparisonSnapshotSchema = new Schema<IComparisonSnapshot>({
+  status: { type: String, enum: ["running", "complete", "failed"], required: true },
+  trigger: { type: String, enum: ["cron", "manual", "import"], required: true },
+  requestedBy: String,
+  startedAt: { type: Date, required: true },
+  finishedAt: Date,
+  durationMs: Number,
+  error: String,
+  inventoryVersion: { type: String, required: true },
+  calculationVersion: { type: Number, required: true },
+  // Large, write-once, read lean: stored as plain objects, never cast field by field.
+  independentSnapshots: Schema.Types.Mixed,
+  baseline: Schema.Types.Mixed,
+  independent: Schema.Types.Mixed,
+});
+
+comparisonSnapshotSchema.index({ status: 1, startedAt: -1 }, { name: "status_started" });
+
+export const ComparisonSnapshotModel = mongoose.model<IComparisonSnapshot>(
+  "SanctionComparisonSnapshot",
+  comparisonSnapshotSchema,
+  "sanction-comparison-snapshots",
+);
diff --git a/apps/server/src/modules/sanction-pep/comparison/comparison.pure.test.ts b/apps/server/src/modules/sanction-pep/comparison/comparison.pure.test.ts
new file mode 100644
index 000000000..587fc686c
--- /dev/null
+++ b/apps/server/src/modules/sanction-pep/comparison/comparison.pure.test.ts
@@ -0,0 +1,186 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import { toSideStats, statsPipeline, UNKNOWN_COUNTRY, type SideStats } from "./comparison-stats";
+import {
+  buildDatasetRows,
+  categoryOfTags,
+  categoryOfUninventoried,
+  countryRows,
+  sideTotals,
+  type RegistryRowInput,
+} from "./comparison.pure";
+
+const side = (partial: Partial<SideStats>): SideStats => ({
+  totals: { records: 0, entities: 0, bytes: 0 },
+  datasets: [],
+  countries: [],
+  datasetCountries: [],
+  ...partial,
+});
+
+test("a source's category is its strongest list tag", () => {
+  assert.equal(categoryOfTags(["list.export", "list.sanction"]), "sanctions");
+  assert.equal(categoryOfTags(["list.sanction.counter"]), "sanctions");
+  assert.equal(categoryOfTags(["list.pep", "list.pep.bulk"]), "pep");
+  assert.equal(categoryOfTags(["list.enforcement", "list.export"]), "crime");
+  assert.equal(categoryOfTags(["list.debarment", "sector.health"]), "debarment");
+  assert.equal(categoryOfTags(["list.regulatory", "list.risk"]), "regulatory");
+  assert.equal(categoryOfTags(["sector.maritime"]), "other");
+  assert.equal(categoryOfTags([]), "other");
+  // A prefix match must be a whole tag segment.
+  assert.equal(categoryOfTags(["list.sanctionsish"]), "other");
+});
+
+test("a source outside the inventory is classed by the app's own lists", () => {
+  assert.equal(categoryOfUninventoried("us_ofac_sdn"), "sanctions");
+  assert.equal(categoryOfUninventoried("wd_peps"), "pep");
+  assert.equal(categoryOfUninventoried("wikidata"), "pep");
+  assert.equal(categoryOfUninventoried("ext_gleif"), "other");
+});
+
+test("raw facet output folds country case, keeps unknowns, and sorts", () => {
+  const stats = toSideStats({
+    totals: [{ records: 5, entities: 3, bytes: 900 }],
+    datasets: [
+      { _id: "b_list", records: 2, entities: 1, bytes: 300, lastChange: null, lastSeen: null },
+      { _id: "a_list", records: 3, entities: 2, bytes: 600, lastChange: "2026-11-01T00:00:00" },
+    ],
+    countries: [
+      { _id: "DE", entities: 1 },
+      { _id: "de", entities: 2 },
+      { _id: null, entities: 1 },
+    ],
+    datasetCountries: [
+      { _id: { d: "a_list", c: "DE" }, n: 1 },
+      { _id: { d: "a_list", c: "de" }, n: 1 },
+    ],
+  });
+  assert.deepEqual(stats.totals, { records: 5, entities: 3, bytes: 900 });
+  assert.deepEqual(
+    stats.datasets.map((row) => row.id),
+    ["a_list", "b_list"],
+  );
+  assert.equal(stats.datasets[1]?.lastChange, undefined);
+  assert.deepEqual(stats.countries, [
+    { code: "de", entities: 3 },
+    { code: UNKNOWN_COUNTRY, entities: 1 },
+  ]);
+  assert.deepEqual(stats.datasetCountries, [{ d: "a_list", c: "de", n: 2 }]);
+});
+
+test("no data is an empty side, not a missing one", () => {
+  assert.deepEqual(toSideStats(undefined).totals, { records: 0, entities: 0, bytes: 0 });
+});
+
+test("the pipeline narrows to the given match before counting", () => {
+  const pipeline = statsPipeline({ datasetId: "x" });
+  assert.deepEqual(pipeline[0], { $match: { datasetId: "x" } });
+  assert.ok(!("$match" in (statsPipeline()[0] ?? {})));
+});
+
+test("totals count sources with data and known countries only", () => {
+  const totals = sideTotals(
+    side({
+      totals: { records: 10, entities: 4, bytes: 1000 },
+      datasets: [
+        { id: "a", records: 10, entities: 4, bytes: 1000 },
+        { id: "b", records: 0, entities: 0, bytes: 0 },
+      ],
+      countries: [
+        { code: "ru", entities: 3 },
+        { code: UNKNOWN_COUNTRY, entities: 1 },
+      ],
+    }),
+  );
+  assert.deepEqual(totals, { records: 10, entities: 4, bytes: 1000, datasets: 1, countries: 1 });
+  assert.equal(sideTotals(undefined), null);
+});
+
+const registry: RegistryRowInput[] = [
+  {
+    datasetId: "us_ofac_sdn",
+    title: "OFAC SDN",
+    issuerCountry: "United States",
+    category: "sanctions",
+    workStatus: "validated",
+    inventoryEntities: 18000,
+    independent: {
+      snapshotId: "2026-11-12",
+      importedAt: new Date("2026-11-12T05:00:00Z"),
+      fetchCompletedAt: new Date("2026-11-12T04:00:00Z"),
+    },
+  },
+  { datasetId: "pk_nacta", title: "NACTA", category: "sanctions", workStatus: "not_started" },
+];
+
+test("every inventory source is a row, with or without data, then the uninventoried ones", () => {
+  const rows = buildDatasetRows({
+    registry,
+    baseline: side({
+      datasets: [
+        { id: "us_ofac_sdn", records: 75798, entities: 21605, bytes: 1, lastSeen: "2026-09-19" },
+        { id: "ext_gleif", records: 9, entities: 9, bytes: 1 },
+      ],
+    }),
+    independent: side({
+      datasets: [{ id: "us_ofac_sdn", records: 30000, entities: 19000, bytes: 1 }],
+    }),
+    titles: new Map([["ext_gleif", "GLEIF LEI register"]]),
+  });
+
+  assert.deepEqual(
+    rows.map((row) => [row.datasetId, row.inInventory]),
+    [
+      ["us_ofac_sdn", true],
+      ["pk_nacta", true],
+      ["ext_gleif", false],
+    ],
+  );
+  const [ofac, nacta, gleif] = rows;
+  assert.equal(ofac?.baseline?.entities, 21605);
+  assert.equal(ofac?.baseline?.lastSeen, "2026-09-19");
+  assert.equal(ofac?.independent?.entities, 19000);
+  assert.equal(ofac?.independent?.snapshotId, "2026-11-12");
+  assert.equal(ofac?.independent?.fetchedAt, "2026-11-12T04:00:00.000Z");
+  assert.equal(nacta?.baseline, null);
+  assert.equal(nacta?.independent, null);
+  assert.equal(nacta?.workStatus, "not_started");
+  assert.equal(gleif?.title, "GLEIF LEI register");
+  assert.equal(gleif?.category, "other");
+  assert.equal(gleif?.workStatus, undefined);
+});
+
+test("countries: distinct overall, per-source sums when sources are picked", () => {
+  const baseline = side({
+    countries: [
+      { code: "ru", entities: 10 },
+      { code: "ir", entities: 4 },
+    ],
+    datasetCountries: [
+      { d: "a", c: "ru", n: 7 },
+      { d: "b", c: "ru", n: 5 },
+      { d: "b", c: "ir", n: 4 },
+    ],
+  });
+  const independent = side({
+    countries: [{ code: "ru", entities: 6 }],
+    datasetCountries: [{ d: "a", c: "ru", n: 6 }],
+  });
+
+  const all = countryRows({ baseline, independent });
+  assert.equal(all.distinct, true);
+  assert.deepEqual(all.rows, [
+    { code: "ru", baseline: 10, independent: 6 },
+    { code: "ir", baseline: 4, independent: 0 },
+  ]);
+
+  const one = countryRows({ baseline, independent, datasets: new Set(["a"]) });
+  assert.equal(one.distinct, true);
+  assert.deepEqual(one.rows, [{ code: "ru", baseline: 7, independent: 6 }]);
+
+  // Two picked sources: a party on both counts twice (7 + 5 > the 10 distinct).
+  const two = countryRows({ baseline, independent, datasets: new Set(["a", "b"]) });
+  assert.equal(two.distinct, false);
+  assert.deepEqual(two.rows[0], { code: "ru", baseline: 12, independent: 6 });
+});
diff --git a/apps/server/src/modules/sanction-pep/comparison/comparison.pure.ts b/apps/server/src/modules/sanction-pep/comparison/comparison.pure.ts
new file mode 100644
index 000000000..8c50f824d
--- /dev/null
+++ b/apps/server/src/modules/sanction-pep/comparison/comparison.pure.ts
@@ -0,0 +1,215 @@
+import {
+  SOURCE_CATEGORIES,
+  WORK_STATUSES,
+  type ComparisonCountryRow,
+  type ComparisonDatasetRow,
+  type ComparisonSideTotals,
+  type SourceCategory,
+  type WorkStatus,
+} from "@repo/types/modules/sanctions/comparison";
+
+import { PEP_ONLY_IN_SANCTIONS } from "../pep-sources";
+import { SANCTION_LISTS_SNAPSHOT } from "../sanction-lists";
+import { UNKNOWN_COUNTRY, type SideStats } from "./comparison-stats";
+
+/**
+ * The inventory's `list.*` tags, strongest first: a source tagged both sanction
+ * and export is a sanctions source. Sector-only tags (health, maritime…) are "other".
+ */
+const TAG_CATEGORIES: Array<[prefix: string, category: SourceCategory]> = [
+  ["list.sanction", "sanctions"],
+  ["list.pep", "pep"],
+  ["list.wanted", "crime"],
+  ["list.terror", "crime"],
+  ["list.enforcement", "crime"],
+  ["list.debarment", "debarment"],
+  ["list.export", "regulatory"],
+  ["list.regulatory", "regulatory"],
+  ["list.risk", "regulatory"],
+];
+
+export function categoryOfTags(tags: readonly string[]): SourceCategory {
+  for (const [prefix, category] of TAG_CATEGORIES) {
+    if (tags.some((tag) => tag === prefix || tag.startsWith(`${prefix}.`))) return category;
+  }
+  return "other";
+}
+
+const SANCTION_LISTS = new Set<string>(SANCTION_LISTS_SNAPSHOT);
+const POLITICIAN_SOURCES = new Set<string>(PEP_ONLY_IN_SANCTIONS);
+
+/** A source the inventory lacks (e.g. `ext_gleif`): classified by the app's own lists. */
+export function categoryOfUninventoried(datasetId: string): SourceCategory {
+  if (SANCTION_LISTS.has(datasetId)) return "sanctions";
+  if (
+    POLITICIAN_SOURCES.has(datasetId) ||
+    datasetId === "wikidata" ||
+    datasetId.startsWith("wd_")
+  ) {
+    return "pep";
+  }
+  return "other";
+}
+
+export function sideTotals(stats: SideStats | undefined): ComparisonSideTotals | null {
+  if (!stats) return null;
+  return {
+    records: stats.totals.records,
+    entities: stats.totals.entities,
+    bytes: stats.totals.bytes,
+    datasets: stats.datasets.filter((dataset) => dataset.records > 0).length,
+    countries: stats.countries.filter((country) => country.code !== UNKNOWN_COUNTRY).length,
+  };
+}
+
+export const emptyStatusCounts = (): Record<WorkStatus, number> =>
+  Object.fromEntries(WORK_STATUSES.map((status) => [status, 0])) as Record<WorkStatus, number>;
+
+export const emptyCategoryCounts = (): Record<SourceCategory, number> =>
+  Object.fromEntries(SOURCE_CATEGORIES.map((category) => [category, 0])) as Record<
+    SourceCategory,
+    number
+  >;
+
+export interface RegistryRowInput {
+  datasetId: string;
+  title: string;
+  publisher?: string;
+  issuerCountry?: string;
+  updates?: string;
+  category: SourceCategory;
+  workStatus: WorkStatus;
+  blocker?: string;
+  inventoryEntities?: number;
+  independent?: {
+    snapshotId: string;
+    importedAt: Date;
+    fetchCompletedAt?: Date;
+  };
+}
+
+/**
+ * Every source either side knows: all inventory rows (with or without data, so
+ * untouched sources stay visible), then any source only the data holds.
+ */
+export function buildDatasetRows(input: {
+  registry: readonly RegistryRowInput[];
+  baseline?: SideStats;
+  independent?: SideStats;
+  /** Titles for sources outside the inventory, from `sanction-dataset-descr`. */
+  titles?: ReadonlyMap<string, string>;
+}): ComparisonDatasetRow[] {
+  const baseline = new Map(input.baseline?.datasets.map((row) => [row.id, row]));
+  const independent = new Map(input.independent?.datasets.map((row) => [row.id, row]));
+  const rows: ComparisonDatasetRow[] = [];
+  const seen = new Set<string>();
+
+  for (const source of input.registry) {
+    seen.add(source.datasetId);
+    const base = baseline.get(source.datasetId);
+    const ours = independent.get(source.datasetId);
+    rows.push({
+      datasetId: source.datasetId,
+      title: source.title,
+      ...(source.publisher ? { publisher: source.publisher } : {}),
+      ...(source.issuerCountry ? { issuerCountry: source.issuerCountry } : {}),
+      ...(source.updates ? { updates: source.updates } : {}),
+      category: source.category,
+      inInventory: true,
+      workStatus: source.workStatus,
+      ...(source.blocker ? { blocker: source.blocker } : {}),
+      ...(source.inventoryEntities !== undefined
+        ? { inventoryEntities: source.inventoryEntities }
+        : {}),
+      baseline: base ? baselineCounts(base) : null,
+      independent: ours
+        ? {
+            records: ours.records,
+            entities: ours.entities,
+            bytes: ours.bytes,
+            ...(ours.lastChange ? { lastChange: ours.lastChange } : {}),
+            ...(source.independent
+              ? {
+                  snapshotId: source.independent.snapshotId,
+                  importedAt: source.independent.importedAt.toISOString(),
+                  ...(source.independent.fetchCompletedAt
+                    ? { fetchedAt: source.independent.fetchCompletedAt.toISOString() }
+                    : {}),
+                }
+              : {}),
+          }
+        : null,
+    });
+  }
+
+  const extras = new Set([...baseline.keys(), ...independent.keys()]);
+  for (const datasetId of [...extras].filter((id) => !seen.has(id)).sort()) {
+    const base = baseline.get(datasetId);
+    const ours = independent.get(datasetId);
+    rows.push({
+      datasetId,
+      title: input.titles?.get(datasetId) ?? datasetId,
+      category: categoryOfUninventoried(datasetId),
+      inInventory: false,
+      baseline: base ? baselineCounts(base) : null,
+      independent: ours
+        ? {
+            records: ours.records,
+            entities: ours.entities,
+            bytes: ours.bytes,
+            ...(ours.lastChange ? { lastChange: ours.lastChange } : {}),
+          }
+        : null,
+    });
+  }
+  return rows;
+}
+
+function baselineCounts(row: SideStats["datasets"][number]) {
+  return {
+    records: row.records,
+    entities: row.entities,
+    bytes: row.bytes,
+    ...(row.lastChange ? { lastChange: row.lastChange } : {}),
+    ...(row.lastSeen ? { lastSeen: row.lastSeen } : {}),
+  };
+}
+
+/**
+ * Parties per entity country, both sides.
+ *
+ * With no sources picked this is the distinct count per country. With sources
+ * picked it adds the per-source counts, so a party on two picked sources counts
+ * twice — the response says so (`distinct: false`).
+ */
+export function countryRows(input: {
+  baseline?: SideStats;
+  independent?: SideStats;
+  datasets?: ReadonlySet<string>;
+}): { distinct: boolean; rows: ComparisonCountryRow[] } {
+  const totals = new Map<string, ComparisonCountryRow>();
+  const add = (code: string, side: "baseline" | "independent", n: number) => {
+    const row = totals.get(code) ?? { code, baseline: 0, independent: 0 };
+    row[side] += n;
+    totals.set(code, row);
+  };
+
+  for (const side of ["baseline", "independent"] as const) {
+    const stats = input[side];
+    if (!stats) continue;
+    if (input.datasets) {
+      for (const pair of stats.datasetCountries) {
+        if (input.datasets.has(pair.d)) add(pair.c, side, pair.n);
+      }
+    } else {
+      for (const country of stats.countries) add(country.code, side, country.entities);
+    }
+  }
+
+  return {
+    distinct: !input.datasets || input.datasets.size <= 1,
+    rows: [...totals.values()].sort(
+      (a, b) => Math.max(b.baseline, b.independent) - Math.max(a.baseline, a.independent),
+    ),
+  };
+}
diff --git a/apps/server/src/modules/sanction-pep/comparison/comparison.router.ts b/apps/server/src/modules/sanction-pep/comparison/comparison.router.ts
new file mode 100644
index 000000000..5fa739ca4
--- /dev/null
+++ b/apps/server/src/modules/sanction-pep/comparison/comparison.router.ts
@@ -0,0 +1,78 @@
+import { createApiSuccessResponse } from "@repo/shared/types";
+import {
+  comparisonCountriesQuerySchema,
+  comparisonDatasetParamsSchema,
+  updateComparisonSourceSchema,
+  type ComparisonCountriesQuery,
+  type UpdateComparisonSourceBody,
+} from "@repo/types/modules/sanctions/comparison";
+import { Router } from "express";
+
+import { checkAdmin } from "@/middlewares/auth-middleware";
+import { validate } from "@/middlewares/validate";
+
+import {
+  getDatasetDetail,
+  getSummary,
+  listCountries,
+  listDatasets,
+  requestRefresh,
+  updateSource,
+} from "./comparison.service";
+
+/**
+ * Admin-only. Every read serves the stored comparison; none counts
+ * `sanctions-data` itself. Refresh queues one comparison and returns at once.
+ */
+const sanctionsComparisonRouter: Router = Router();
+
+sanctionsComparisonRouter.use(checkAdmin);
+
+sanctionsComparisonRouter.get("/summary", async (_req, res) => {
+  res.json(createApiSuccessResponse(await getSummary()));
+});
+
+sanctionsComparisonRouter.get("/datasets", async (_req, res) => {
+  res.json(createApiSuccessResponse(await listDatasets()));
+});
+
+sanctionsComparisonRouter.get(
+  "/countries",
+  validate({ query: comparisonCountriesQuerySchema }),
+  async (req, res) => {
+    res.json(
+      createApiSuccessResponse(
+        await listCountries(req.query as unknown as ComparisonCountriesQuery),
+      ),
+    );
+  },
+);
+
+sanctionsComparisonRouter.get(
+  "/datasets/:datasetId",
+  validate({ params: comparisonDatasetParamsSchema }),
+  async (req, res) => {
+    res.json(createApiSuccessResponse(await getDatasetDetail(String(req.params.datasetId))));
+  },
+);
+
+sanctionsComparisonRouter.patch(
+  "/sources/:datasetId",
+  validate({ params: comparisonDatasetParamsSchema, body: updateComparisonSourceSchema }),
+  async (req, res) => {
+    const workStatus = await updateSource(
+      String(req.params.datasetId),
+      req.body as UpdateComparisonSourceBody,
+      req.user?.email ?? undefined,
+    );
+    res.json(createApiSuccessResponse({ workStatus }));
+  },
+);
+
+sanctionsComparisonRouter.post("/refresh", async (req, res) => {
+  res
+    .status(202)
+    .json(createApiSuccessResponse(await requestRefresh(req.user?.email ?? undefined)));
+});
+
+export { sanctionsComparisonRouter };
