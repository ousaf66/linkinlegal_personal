index 000000000..3db08c9e0
--- /dev/null
+++ b/packages/types/src/modules/sanctions/comparison.ts
@@ -0,0 +1,318 @@
+import { z } from "zod";
+
+/**
+ * The internal sanctions comparison: the provider feed we load today (baseline)
+ * beside the sources our own scrapers deliver (independent), source by source and
+ * country by country. Admin only.
+ */
+
+export const SOURCE_CATEGORIES = [
+  "sanctions",
+  "pep",
+  "crime",
+  "debarment",
+  "regulatory",
+  "other",
+] as const;
+export type SourceCategory = (typeof SOURCE_CATEGORIES)[number];
+
+/** Where a source stands in the scraper work. Imports move it to `validated`; people set the rest. */
+export const WORK_STATUSES = [
+  "not_started",
+  "in_progress",
+  "blocked",
+  "delivered",
+  "validated",
+  "searchable",
+] as const;
+export type WorkStatus = (typeof WORK_STATUSES)[number];
+
+export type ComparisonJobStatus = "running" | "complete" | "failed";
+export type ComparisonTrigger = "cron" | "manual" | "import";
+
+export interface ComparisonJobDto {
+  id: string;
+  status: ComparisonJobStatus;
+  trigger: ComparisonTrigger;
+  requestedBy?: string;
+  startedAt: string;
+  finishedAt?: string;
+  durationMs?: number;
+  error?: string;
+}
+
+export interface ComparisonSideTotals {
+  /** Every record, statements about parties included. */
+  records: number;
+  /** Parties only: people, companies, vessels and the like. */
+  entities: number;
+  bytes: number;
+  /** Sources with at least one record. */
+  datasets: number;
+  /** Entity countries with at least one party ("unknown" not counted). */
+  countries: number;
+}
+
+export interface ComparisonSummaryDto {
+  /** The comparison every number on the page comes from; null before the first one finishes. */
+  comparison: ComparisonJobDto | null;
+  /** A newer attempt that is still running or failed, shown beside the one in use. */
+  latestAttempt: ComparisonJobDto | null;
+  inventory: {
+    version: string;
+    sources: number;
+    byStatus: Record<WorkStatus, number>;
+    byCategory: Record<SourceCategory, number>;
+  };
+  baseline: ComparisonSideTotals | null;
+  independent: ComparisonSideTotals | null;
+}
+
+export interface ComparisonSideCounts {
+  records: number;
+  entities: number;
+  bytes: number;
+  /** Newest `last_change` among the source's records: content changed, not when it was fetched. */
+  lastChange?: string;
+}
+
+export interface ComparisonDatasetRow {
+  datasetId: string;
+  title: string;
+  publisher?: string;
+  issuerCountry?: string;
+  category: SourceCategory;
+  /** One of the inventory's sources; false for a source only one side holds. */
+  inInventory: boolean;
+  updates?: string;
+  workStatus?: WorkStatus;
+  blocker?: string;
+  /** Parties the provider's own catalogue listed for it on the inventory date. */
+  inventoryEntities?: number;
+  baseline: (ComparisonSideCounts & { lastSeen?: string }) | null;
+  independent:
+    | (ComparisonSideCounts & {
+        snapshotId?: string;
+        importedAt?: string;
+        fetchedAt?: string;
+      })
+    | null;
+}
+
+export interface ComparisonDatasetsResponse {
+  comparisonId: string | null;
+  generatedAt: string | null;
+  rows: ComparisonDatasetRow[];
+}
+
+export interface ComparisonCountryRow {
+  /** ISO code in lower case as the data spells it, or "unknown". */
+  code: string;
+  baseline: number;
+  independent: number;
