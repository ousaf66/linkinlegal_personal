+import type { Metadata } from "next";
+
+import { ScraperInternalPage } from "@/features/scraper-internal/scraper-internal-page";
+
+export const metadata: Metadata = {
+  title: "Scraper internal",
+  robots: { index: false, follow: false },
+};
+
+// Staff tool: the feed beside our own scrapers. Outside the app shell and plan-free
+// (see proxy.ts); sign-in is still required and the API admits admins only.
+export default function ScraperInternalRoute() {
+  return <ScraperInternalPage />;
+}
