diff --git a/apps/admin/tests/scraper-internal-compute.test.ts b/apps/admin/tests/scraper-internal-compute.test.ts
new file mode 100644
index 000000000..9f14c0bbd
--- /dev/null
+++ b/apps/admin/tests/scraper-internal-compute.test.ts
@@ -0,0 +1,139 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import {
+  buildDatasetRows,
+  categoryOfTags,
+  countryRows,
+  sideTotals,
+  UNKNOWN_COUNTRY,
+  type RegistryRowInput,
+  type SideStats,
+} from "../src/pages/_components/scraper-internal/data/compute";
+
+const side = (partial: Partial<SideStats>): SideStats => ({
+  totals: { records: 0, entities: 0, bytes: 0 },
+  datasets: [],
+  countries: [],
+  datasetCountries: [],
+  ...partial,
+});
+
+test("a source's category is its strongest list tag", () => {
+  assert.equal(categoryOfTags(["list.export", "list.sanction"]), "sanctions");
+  assert.equal(categoryOfTags(["list.sanction.counter"]), "sanctions");
+  assert.equal(categoryOfTags(["list.pep", "list.pep.bulk"]), "pep");
+  assert.equal(categoryOfTags(["list.enforcement", "list.export"]), "crime");
+  assert.equal(categoryOfTags(["list.debarment", "sector.health"]), "debarment");
+  assert.equal(categoryOfTags(["list.regulatory", "list.risk"]), "regulatory");
+  assert.equal(categoryOfTags(["sector.maritime"]), "other");
+  assert.equal(categoryOfTags([]), "other");
+  // A prefix match must be a whole tag segment.
+  assert.equal(categoryOfTags(["list.sanctionsish"]), "other");
+});
+
+test("totals count sources with data and known countries only", () => {
+  const totals = sideTotals(
+    side({
+      totals: { records: 10, entities: 4, bytes: 1000 },
+      datasets: [
+        { id: "a", records: 10, entities: 4, bytes: 1000 },
+        { id: "b", records: 0, entities: 0, bytes: 0 },
+      ],
+      countries: [
+        { code: "ru", entities: 3 },
+        { code: UNKNOWN_COUNTRY, entities: 1 },
+      ],
+    }),
+  );
+  assert.deepEqual(totals, { records: 10, entities: 4, bytes: 1000, datasets: 1, countries: 1 });
+  assert.equal(sideTotals(undefined), null);
+});
+
+const registry: RegistryRowInput[] = [
+  {
+    datasetId: "us_ofac_sdn",
+    title: "OFAC SDN",
+    issuerCountry: "United States",
+    category: "sanctions",
+    workStatus: "validated",
+    inventoryEntities: 18000,
+    independent: {
+      snapshotId: "2026-11-12",
+      importedAt: new Date("2026-11-12T05:00:00Z"),
+      fetchCompletedAt: new Date("2026-11-12T04:00:00Z"),
+    },
+  },
+  { datasetId: "pk_nacta", title: "NACTA", category: "sanctions", workStatus: "not_started" },
+];
+
+test("every inventory source is a row, with or without data, then the uninventoried ones", () => {
+  const rows = buildDatasetRows({
+    registry,
+    baseline: side({
+      datasets: [
+        { id: "us_ofac_sdn", records: 75798, entities: 21605, bytes: 1, lastSeen: "2026-09-19" },
+        { id: "ext_gleif", records: 9, entities: 9, bytes: 1 },
+      ],
+    }),
+    independent: side({
+      datasets: [{ id: "us_ofac_sdn", records: 30000, entities: 19000, bytes: 1 }],
+    }),
+    titles: new Map([["ext_gleif", "GLEIF LEI register"]]),
+  });
+
+  assert.deepEqual(
+    rows.map((row) => [row.datasetId, row.inInventory]),
+    [
+      ["us_ofac_sdn", true],
+      ["pk_nacta", true],
+      ["ext_gleif", false],
+    ],
+  );
+  const [ofac, nacta, gleif] = rows;
+  assert.equal(ofac?.baseline?.entities, 21605);
+  assert.equal(ofac?.baseline?.lastSeen, "2026-09-19");
+  assert.equal(ofac?.independent?.entities, 19000);
+  assert.equal(ofac?.independent?.snapshotId, "2026-11-12");
+  assert.equal(ofac?.independent?.fetchedAt, "2026-11-12T04:00:00.000Z");
+  assert.equal(nacta?.baseline, null);
+  assert.equal(nacta?.independent, null);
+  assert.equal(nacta?.workStatus, "not_started");
+  assert.equal(gleif?.title, "GLEIF LEI register");
+  assert.equal(gleif?.category, "other");
+  assert.equal(gleif?.workStatus, undefined);
+});
+
+test("countries: distinct overall, per-source sums when sources are picked", () => {
+  const baseline = side({
+    countries: [
+      { code: "ru", entities: 10 },
+      { code: "ir", entities: 4 },
+    ],
+    datasetCountries: [
+      { d: "a", c: "ru", n: 7 },
+      { d: "b", c: "ru", n: 5 },
+      { d: "b", c: "ir", n: 4 },
+    ],
+  });
+  const independent = side({
+    countries: [{ code: "ru", entities: 6 }],
+    datasetCountries: [{ d: "a", c: "ru", n: 6 }],
+  });
+
+  const all = countryRows({ baseline, independent });
+  assert.equal(all.distinct, true);
+  assert.deepEqual(all.rows, [
+    { code: "ru", baseline: 10, independent: 6 },
+    { code: "ir", baseline: 4, independent: 0 },
+  ]);
+
+  const one = countryRows({ baseline, independent, datasets: new Set(["a"]) });
+  assert.equal(one.distinct, true);
+  assert.deepEqual(one.rows, [{ code: "ru", baseline: 7, independent: 6 }]);
+
+  // Two picked sources: a party on both counts twice (7 + 5 > the 10 distinct).
+  const two = countryRows({ baseline, independent, datasets: new Set(["a", "b"]) });
+  assert.equal(two.distinct, false);
+  assert.deepEqual(two.rows[0], { code: "ru", baseline: 12, independent: 6 });
+});
diff --git a/apps/admin/tests/scraper-internal-delivery-contract.test.ts b/apps/admin/tests/scraper-internal-delivery-contract.test.ts
new file mode 100644
index 000000000..4cb3095d4
--- /dev/null
+++ b/apps/admin/tests/scraper-internal-delivery-contract.test.ts
@@ -0,0 +1,98 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import {
+  independentManifestSchema,
+  independentRecordSchema,
+} from "../src/pages/_components/scraper-internal/data/delivery-contract";
+
+const SHA = "a".repeat(64);
+
+const success = {
+  contractVersion: 1,
+  provider: "independent",
+  datasetId: "us_ofac_sdn",
+  snapshotId: "2026-11-12T0400Z",
+  adapterVersion: "ofac-sdn@1.0.0",
+  status: "success",
+  sourceUrls: [
+    "https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.XML",
+  ],
+  publishedAt: null,
+  fetchStartedAt: "2026-11-12T04:00:00Z",
+  fetchCompletedAt: "2026-11-12T04:03:10+00:00",
+  complete: true,
+  sourceTotal: 18000,
+  counts: { extracted: 75800, accepted: 75798, rejected: 2, duplicates: 0 },
+  files: [{ path: "entities.ftm.jsonl", sha256: SHA, bytes: 1234, rows: 75798 }],
+};
+
+const problems = (value: unknown) => {
+  const parsed = independentManifestSchema.safeParse(value);
+  return parsed.success ? [] : parsed.error.issues.map((issue) => issue.path.join("."));
+};
+
+test("a complete successful delivery is accepted", () => {
+  assert.deepEqual(problems(success), []);
+});
+
+test("a failed run must say why it failed", () => {
+  const failed = {
+    ...success,
+    status: "failed",
+    files: [],
+    counts: { ...success.counts, accepted: 0 },
+  };
+  assert.deepEqual(problems(failed), ["error"]);
+  assert.deepEqual(problems({ ...failed, error: "HTTP 503 from the publisher" }), []);
+});
+
+test("partial snapshots, row mismatches and missing payloads are refused", () => {
+  assert.deepEqual(problems({ ...success, complete: false }), ["complete"]);
+  assert.deepEqual(problems({ ...success, counts: { ...success.counts, accepted: 5 } }), [
+    "counts.accepted",
+  ]);
+  assert.ok(
+    problems({ ...success, files: [], counts: { ...success.counts, accepted: 0 } }).includes(
+      "files",
+    ),
+  );
+  assert.ok(problems({ ...success, fetchCompletedAt: undefined }).includes("fetchCompletedAt"));
+});
+
+test("payload files are names beside the manifest, never paths out of it", () => {
+  for (const path of ["../entities.jsonl", "/tmp/x.jsonl", "sub/x.jsonl", "x.json"]) {
+    assert.ok(
+      problems({ ...success, files: [{ ...success.files[0], path }] }).length > 0,
+      `${path} must be refused`,
+    );
+  }
+});
+
+test("dataset IDs are inventory IDs and the version is pinned", () => {
+  assert.ok(problems({ ...success, datasetId: "US OFAC" }).includes("datasetId"));
+  assert.ok(problems({ ...success, contractVersion: 2 }).includes("contractVersion"));
+});
+
+test("records are FtM entities with string-array properties and our own IDs", () => {
+  const record = {
+    id: "llg-us-ofac-sdn-36",
+    caption: "AEROCARIBBEAN AIRLINES",
+    schema: "Organization",
+    properties: { name: ["AEROCARIBBEAN AIRLINES"], country: ["cu"] },
+    datasets: ["us_ofac_sdn"],
+    target: true,
+    first_seen: "2026-11-12T04:03:10",
+  };
+  assert.ok(independentRecordSchema.safeParse(record).success);
+  assert.ok(!independentRecordSchema.safeParse({ ...record, id: "NK-abc" }).success);
+  assert.ok(!independentRecordSchema.safeParse({ ...record, schema: "organization" }).success);
+  assert.ok(
+    !independentRecordSchema.safeParse({ ...record, properties: { name: "AEROCARIBBEAN" } })
+      .success,
+  );
+  // An identifier keeps its leading zeros: it is a string, never a number.
+  assert.ok(
+    !independentRecordSchema.safeParse({ ...record, properties: { idNumber: [7] } }).success,
+  );
+});
diff --git a/apps/admin/tests/scraper-internal-test-data.test.ts b/apps/admin/tests/scraper-internal-test-data.test.ts
new file mode 100644
index 000000000..83eb54aa4
--- /dev/null
+++ b/apps/admin/tests/scraper-internal-test-data.test.ts
@@ -0,0 +1,77 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+
+import {
+  getDatasetDetail,
+  getSummary,
+  listDatasets,
+} from "../src/pages/_components/scraper-internal/data/service";
+import {
+  TEST_SCRAPED_SOURCES,
+  testData,
+} from "../src/pages/_components/scraper-internal/data/test-data";
+import inventory from "../src/pages/_components/scraper-internal/data/source-inventory.json";
+
+test("every inventory source is listed, and only those", () => {
+  const { rows, dataSource } = listDatasets();
+  assert.equal(dataSource, "test");
+  assert.equal(rows.length, inventory.sources.length);
+  assert.ok(rows.every((row) => row.inInventory));
+});
+
+test("the feed side follows each source's catalogue count", () => {
+  const ofac = inventory.sources.find((source) => source.id === "us_ofac_sdn")!;
+  const row = listDatasets().rows.find((candidate) => candidate.datasetId === "us_ofac_sdn")!;
+  assert.equal(row.baseline?.entities, ofac.inventoryEntities);
+});
+
+test("only the test sources have a scraper side, each validated with a delivery", () => {
+  const { rows } = listDatasets();
+  const scraped = rows
+    .filter((row) => row.independent)
+    .map((row) => row.datasetId)
+    .sort();
+  assert.deepEqual(scraped, [...TEST_SCRAPED_SOURCES].sort());
+  for (const id of TEST_SCRAPED_SOURCES) {
+    const detail = getDatasetDetail(id);
+    assert.equal(detail.row.workStatus, "validated");
+    assert.ok(detail.runs.some((run) => run.status === "imported"));
+  }
+});
+
+test("each source's countries add up to its parties, on both sides", () => {
+  const data = testData();
+  for (const side of [data.baseline, data.independent]) {
+    const byDataset = new Map<string, number>();
+    for (const pair of side.datasetCountries) {
+      byDataset.set(pair.d, (byDataset.get(pair.d) ?? 0) + pair.n);
+    }
+    for (const dataset of side.datasets) {
+      assert.equal(byDataset.get(dataset.id) ?? 0, dataset.entities, dataset.id);
+    }
+  }
+});
+
+test("the summary adds up and the statuses cover all 477 sources", () => {
+  const summary = getSummary();
+  assert.equal(summary.inventory.sources, 477);
+  assert.equal(
+    Object.values(summary.inventory.byStatus).reduce((sum, n) => sum + n, 0),
+    477,
+  );
+  assert.equal(summary.inventory.byStatus.validated, TEST_SCRAPED_SOURCES.length);
+  assert.equal(summary.inventory.byStatus.blocked, 2);
+  assert.equal(summary.independent.datasets, TEST_SCRAPED_SOURCES.length);
+  assert.ok(summary.baseline.entities > summary.independent.entities);
+});
+
+test("the same figures every time", () => {
+  assert.deepEqual(
+    JSON.parse(JSON.stringify(getSummary())),
+    JSON.parse(JSON.stringify(getSummary())),
+  );
+});
+
+test("an unknown source is an error, not an empty page", () => {
+  assert.throws(() => getDatasetDetail("not_a_source"), /No source not_a_source/);
+});
